<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app2="http://schemas.android.com/apk/res-auto">

    <git.artdeell.mojo.prefs.BackButtonPreference />

    <PreferenceCategory android:title="@string/preference_category_miscellaneous">
        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:icon="@drawable/ic_px_image"
            android:key="zyroxAnimatedBg"
            android:title="@string/zyrox_pref_animated_bg_title"
            android:summary="@string/zyrox_pref_animated_bg_summary" />

        <androidx.preference.ListPreference
            android:defaultValue="bicubic"
            android:icon="@drawable/ic_px_image"
            android:key="zyroxGifFilter"
            android:entries="@array/zyrox_gif_filter_names"
            android:entryValues="@array/zyrox_gif_filter_values"
            android:title="@string/zyrox_pref_gif_filter_title"
            android:summary="@string/zyrox_pref_gif_filter_summary"
            app2:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:icon="@drawable/ic_px_alt_sliders"
            android:key="zyroxReducedMotion"
            android:title="@string/zyrox_pref_reduced_motion_title"
            android:summary="@string/zyrox_pref_reduced_motion_summary" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:icon="@drawable/ic_px_zap"
            android:key="zyroxLowEffects"
            android:title="@string/zyrox_pref_low_effects_title"
            android:summary="@string/zyrox_pref_low_effects_summary" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:icon="@drawable/ic_px_console"
            android:key="zyroxPerfHud"
            android:title="@string/zyrox_pref_perf_hud_title"
            android:summary="@string/zyrox_pref_perf_hud_summary" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:icon="@drawable/ic_px_file_dl"
            android:key="zyroxWarnMobileData"
            android:title="@string/zyrox_pref_warn_mobile_title"
            android:summary="@string/zyrox_pref_warn_mobile_summary" />

        <Preference
            android:key="selectBgVideo"
            android:icon="@drawable/ic_px_file"
            android:title="@string/zyrox_pref_select_bg_video_title"
            android:summary="@string/zyrox_pref_select_bg_video_summary" />

        <Preference
            android:key="resetBgVideo"
            android:icon="@drawable/ic_px_trash"
            android:title="@string/zyrox_pref_reset_bg_video_title"
            android:summary="@string/zyrox_pref_reset_bg_video_summary" />

        <SwitchPreferenceCompat
            android:title="@string/preference_force_english_title"
            android:key="force_english"
            android:summary="@string/preference_force_english_description"
            android:icon="@drawable/ic_px_translate" />

        <Preference
            android:title="@string/preference_ask_for_notification_title"
            android:summary="@string/preference_ask_for_notification_description"
            android:key="notification_permission_request"
            android:icon="@drawable/ic_px_bell" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:icon="@drawable/ic_px_hash"
            android:key="checkGameFiles"
            android:summary="@string/preference_verify_game_files_description"
            android:title="@string/preference_verify_game_files_title" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:icon="@drawable/ic_px_zap"
            android:key="fastStartupCheck"
            android:summary="@string/preference_go_vroom_description"
            android:title="@string/preference_go_vroom_title" />

        <androidx.preference.ListPreference
            android:defaultValue="default"
            android:icon="@drawable/ic_px_file_dl"
            android:key="downloadSource"
            android:entries="@array/download_source_names"
            android:entryValues="@array/download_source_values"
            android:title="@string/preference_download_source_title"
            android:summary="@string/preference_download_source_description"
            app2:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:icon="@drawable/ic_px_verify_hash"
            android:key="verifyManifest"
            android:title="@string/preference_verify_manifest_title"
            android:summary="@string/preference_verify_manifest_description" />

        <Preference
            android:key="microphoneAccessRequest"
            android:icon="@drawable/ic_microphone"
            android:title="@string/preference_microphone_access_title"
            android:summary="@string/preference_microphone_access_description" />

        <Preference
            android:key="runDataMigration"
            android:icon="@drawable/ic_px_data_import"
            android:title="@string/preference_data_migration_title"
            android:summary="@string/preference_data_migration_summary" />

        <Preference
            android:key="clearMetadataCache"
            android:title="@string/preference_metadata_clear"
            android:summary="@string/preference_metadata_clear_summary" />

        <git.artdeell.mojo.prefs.ClearPartfileCachePreference
            android:title="@string/pref_clean_partfiles_title" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:icon="@drawable/ic_px_memory_warning"
            android:key="showMemoryWarning"
            android:title="@string/preference_show_memory_warning_title"
            android:summary="@string/preference_show_memory_warning_summary" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="disableServerBlocklist"
            android:title="@string/pref_blocklist_disable_title"
            android:summary="@string/pref_blocklist_disable_description" />

    </PreferenceCategory>
</PreferenceScreen>
