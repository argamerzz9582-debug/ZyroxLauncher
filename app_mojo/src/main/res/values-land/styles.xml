<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="MojoLauncher.AppTheme" parent="MojoLauncher">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@color/zyrox_bg_base</item>
        <item name="android:navigationBarColor">@color/zyrox_bg_base</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Material</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="LauncherMenuButton.Universal" parent="LauncherMenuButton">
        <item name="android:layout_height">34dp</item>
    </style>
</resources>
