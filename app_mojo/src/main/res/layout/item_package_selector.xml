<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="54dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_zyrox_glass_card"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/selector_view_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:textColor="@color/zyrox_text_primary"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:fontFamily="@font/minecraft_pixel"
        app:fontFamily="@font/minecraft_pixel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/selector_action_barrier"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Internal-21" />

    <TextView
        android:id="@+id/selector_view_ext_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="8dp"
        android:textColor="@color/zyrox_text_secondary"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:fontFamily="monospace"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/selector_action_barrier"
        app:layout_constraintTop_toBottomOf="@+id/selector_view_name"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:text="OpenJDK 21.0.4 (arm64)" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/selector_action_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="selector_view_removebtn,selector_view_setdefaultbtn" />

    <ImageButton
        android:id="@+id/selector_view_removebtn"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/btn_zyrox_danger"
        android:padding="7dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_px_trash"
        app:tint="@color/zyrox_danger"
        android:visibility="gone"
        android:contentDescription="@string/global_delete"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

    <Button
        android:id="@+id/selector_view_setdefaultbtn"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:minHeight="32dp"
        android:paddingHorizontal="10dp"
        android:background="@drawable/btn_zyrox_secondary"
        android:textColor="@color/zyrox_amber"
        android:textSize="9.5sp"
        android:fontFamily="@font/minecraft_pixel"
        app:fontFamily="@font/minecraft_pixel"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="SET DEFAULT"
        tools:visibility="visible" />
</androidx.constraintlayout.widget.ConstraintLayout>
