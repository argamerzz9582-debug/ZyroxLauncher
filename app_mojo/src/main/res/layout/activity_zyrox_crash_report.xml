<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zyrox_bg_base">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_zyrox_shader_scene"
        android:contentDescription="@string/app_short_name" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_zyrox_vignette" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="10dp"
        android:orientation="vertical"
        android:background="@drawable/bg_zyrox_glass_modal"
        android:padding="14dp"
        android:elevation="16dp">

        <!-- Header Bar with Official Zyrox Logo + ZYROX CRASH REPORT Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_zyrox_logo"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/tv_crash_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_zyrox_badge_danger"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="@string/zyrox_title_crash_report"
                android:textColor="@color/zyrox_danger"
                android:textSize="10sp"
                android:letterSpacing="0.06"
                android:fontFamily="@font/minecraft_pixel"
                app:fontFamily="@font/minecraft_pixel" />

            <TextView
                android:id="@+id/tv_crash_subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:textColor="@color/zyrox_text_primary"
                android:textSize="11.5sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                tools:text="Game exited with code 1" />

            <TextView
                android:id="@+id/tv_crash_confidence_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_zyrox_badge_info"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/zyrox_text_primary"
                android:textSize="9.5sp"
                android:visibility="gone"
                tools:text="HIGH CONFIDENCE"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Prominent Liquid Glass Human-Readable Diagnosis & 1-Tap Fix & Relaunch Card -->
        <LinearLayout
            android:id="@+id/layout_zyrox_guard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_zyrox_glass_surface"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:id="@+id/tv_zyrox_guard_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/zyrox_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Java Runtime Version Mismatch" />

            <TextView
                android:id="@+id/tv_zyrox_guard_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/zyrox_text_secondary"
                android:textSize="11.5sp"
                android:lineSpacingExtra="2dp"
                android:maxLines="4"
                android:ellipsize="end"
                tools:text="Minecraft 1.21 requires Java 21. Tap below to switch Java and launch immediately." />

            <!-- Primary 1-Tap Fix & Relaunch + Secondary Action Chips -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btn_crash_fix_and_relaunch"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:minHeight="36dp"
                    android:paddingHorizontal="14dp"
                    android:background="@drawable/btn_zyrox_play"
                    android:text="1-Tap Fix &amp; Relaunch"
                    android:textAllCaps="false"
                    android:textColor="@color/zyrox_lg_text"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <HorizontalScrollView
                    android:id="@+id/sv_zyrox_autofix_actions"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/layout_zyrox_autofix_actions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <Button
                            android:id="@+id/btn_zyrox_guard_fix"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:minHeight="32dp"
                            android:paddingHorizontal="10dp"
                            android:background="@drawable/btn_zyrox_secondary"
                            android:text="@string/zyrox_safe_mode_apply"
                            android:textColor="@color/zyrox_lg_text"
                            android:textSize="9.5sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>
        </LinearLayout>

        <!-- Expandable "Technical Details" Accordion Toggle (Raw Stacktrace Collapsed by Default) -->
        <TextView
            android:id="@+id/btn_toggle_technical_details"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_zyrox_secondary"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:text="▸ Technical Details (Auto-Redacted Log &amp; Stacktrace)"
            android:textColor="@color/zyrox_text_secondary"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium" />

        <!-- Syntax-Highlighted Monospace Crash Terminal (Collapsed by default; expands on tap) -->
        <ScrollView
            android:id="@+id/sv_crash_terminal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_zyrox_terminal"
            android:padding="10dp"
            android:fillViewport="true"
            android:scrollbars="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_crash_stacktrace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/zyrox_text_secondary"
                android:textSize="10.5sp"
                android:lineSpacingExtra="2dp"
                android:fontFamily="monospace"
                android:textIsSelectable="true" />
        </ScrollView>

        <!-- Spacer that keeps bottom action bar anchored cleanly when Technical Details is collapsed -->
        <View
            android:id="@+id/spacer_crash_collapsed"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Floating Bottom Action Bar: CLOSE / COPY LOG / SHARE LOG / RELAUNCH ZYROX -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btn_crash_close"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minHeight="36dp"
                android:paddingHorizontal="12dp"
                android:background="@drawable/btn_zyrox_danger"
                android:text="@string/zyrox_hud_exit"
                android:textColor="@color/zyrox_danger"
                android:textSize="10sp"
                android:fontFamily="@font/minecraft_pixel"
                app:fontFamily="@font/minecraft_pixel" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/btn_crash_copy"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:tag="custom_bg"
                android:background="@drawable/btn_zyrox_secondary"
                android:paddingHorizontal="14dp"
                android:text="@string/zyrox_copy_log"
                android:textColor="@color/zyrox_text_primary"
                android:textSize="10.5sp" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/btn_crash_share"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:tag="custom_bg"
                android:background="@drawable/btn_zyrox_secondary"
                android:paddingHorizontal="14dp"
                android:text="@string/zyrox_share_log"
                android:textColor="@color/zyrox_amber"
                android:textSize="10.5sp" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/btn_crash_relaunch"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="16dp"
                android:text="@string/zyrox_relaunch"
                android:textColor="@color/zyrox_text_primary"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
