<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zyrox_bg_base">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_zyrox_shader_scene"
        android:contentDescription="@string/app_short_name" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_zyrox_vignette" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="12dp"
        android:orientation="vertical"
        android:background="@drawable/bg_zyrox_glass_modal"
        android:padding="14dp"
        android:elevation="16dp">

        <!-- Header Bar with ZYROX CRASH REPORT Danger Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_crash_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_zyrox_badge_danger"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="@string/zyrox_title_crash_report"
                android:textColor="@color/zyrox_danger"
                android:textSize="10.5sp"
                android:letterSpacing="0.06"
                android:fontFamily="@font/minecraft_pixel"
                app:fontFamily="@font/minecraft_pixel" />

            <TextView
                android:id="@+id/tv_crash_subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:textColor="@color/zyrox_text_primary"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                tools:text="Game exited with code 1" />
        </LinearLayout>

        <!-- Syntax-Highlighted Monospace Crash Terminal -->
        <ScrollView
            android:id="@+id/sv_crash_terminal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginVertical="10dp"
            android:background="@drawable/bg_zyrox_terminal"
            android:padding="10dp"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/tv_crash_stacktrace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/zyrox_text_secondary"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp"
                android:fontFamily="monospace"
                android:textIsSelectable="true" />
        </ScrollView>

        <!-- Floating Bottom Action Bar: CLOSE / COPY LOG / SHARE LOG / RELAUNCH ZYROX -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btn_crash_close"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minHeight="36dp"
                android:paddingHorizontal="12dp"
                android:background="@drawable/btn_zyrox_danger"
                android:text="@string/zyrox_hud_exit"
                android:textColor="@color/zyrox_danger"
                android:textSize="10sp"
                android:fontFamily="@font/minecraft_pixel"
                app:fontFamily="@font/minecraft_pixel" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/btn_crash_copy"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:tag="custom_bg"
                android:background="@drawable/btn_zyrox_secondary"
                android:paddingHorizontal="14dp"
                android:text="@string/zyrox_copy_log"
                android:textColor="@color/zyrox_text_primary"
                android:textSize="10.5sp" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/btn_crash_share"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:tag="custom_bg"
                android:background="@drawable/btn_zyrox_secondary"
                android:paddingHorizontal="14dp"
                android:text="@string/zyrox_share_log"
                android:textColor="@color/zyrox_amber"
                android:textSize="10.5sp" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/btn_crash_relaunch"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="16dp"
                android:text="@string/zyrox_relaunch"
                android:textColor="@color/zyrox_text_primary"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
