<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="34dp"
    android:layout_marginBottom="4dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_zyrox_rail_item"
    android:paddingStart="8dp"
    android:paddingEnd="4dp">

    <ImageView
        android:id="@+id/iv_vault_acc_face"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_default_steve_face" />

    <TextView
        android:id="@+id/tv_vault_acc_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:textColor="@color/zyrox_rail_text"
        android:textSize="10sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:fontFamily="@font/minecraft_pixel"
        app:fontFamily="@font/minecraft_pixel"
        tools:text="Steve" />

    <ImageButton
        android:id="@+id/btn_vault_acc_delete"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_px_trash"
        app:tint="@color/zyrox_danger"
        android:contentDescription="@string/global_delete" />
</LinearLayout>
