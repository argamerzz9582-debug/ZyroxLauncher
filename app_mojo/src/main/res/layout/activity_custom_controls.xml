<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/customctrl_drawerlayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zyrox_bg_base">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Subtle Sakura Scene Preview Backdrop so Liquid Glass transparency can be judged accurately -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_zyrox_shader_scene"
            android:alpha="0.38"
            android:importantForAccessibility="no" />

        <!-- Full-Screen Precision Alignment Grid & Center Crosshair -->
        <git.artdeell.mojo.ui.ZyroxGridOverlayView
            android:id="@+id/zyrox_hud_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Subtle Bottom Alignment Hint -->
        <TextView
            android:id="@+id/tv_zyrox_hud_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_zyrox_glass_card_soft"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="@string/zyrox_hud_hint"
            android:textColor="@color/zyrox_text_muted"
            android:textSize="8.5sp"
            android:letterSpacing="0.06"
            android:fontFamily="@font/minecraft_pixel"
            app:fontFamily="@font/minecraft_pixel"
            android:clickable="false"
            android:focusable="false" />

        <!-- Interactive Touch Control Canvas -->
        <git.artdeell.mojo.input.ControlLayout
            android:id="@+id/customctrl_controllayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- TOP-CENTER FLOATING OBSIDIAN GLASS PILL TOOLBAR -->
        <HorizontalScrollView
            android:id="@+id/zyrox_hud_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="12dp"
            android:background="@drawable/bg_zyrox_floating_pill"
            android:elevation="16dp"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp">

                <!-- Minimize toolbar into compact amber pill -->
                <ImageButton
                    android:id="@+id/btn_hud_collapse"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_zyrox_badge"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_px_close"
                    app:tint="@color/zyrox_amber"
                    android:contentDescription="@string/zyrox_hud_more" />

                <TextView
                    android:id="@+id/btn_hud_add_button"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="6dp"
                    android:gravity="center"
                    android:paddingHorizontal="9dp"
                    android:background="@drawable/btn_zyrox_secondary"
                    android:text="@string/zyrox_hud_add_btn"
                    android:textColor="@color/zyrox_text_primary"
                    android:textSize="9.5sp"
                    android:fontFamily="@font/minecraft_pixel"
                    app:fontFamily="@font/minecraft_pixel" />

                <TextView
                    android:id="@+id/btn_hud_add_drawer"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="5dp"
                    android:gravity="center"
                    android:paddingHorizontal="9dp"
                    android:background="@drawable/btn_zyrox_secondary"
                    android:text="@string/zyrox_hud_add_drawer"
                    android:textColor="@color/zyrox_text_primary"
                    android:textSize="9.5sp"
                    android:fontFamily="@font/minecraft_pixel"
                    app:fontFamily="@font/minecraft_pixel" />

                <TextView
                    android:id="@+id/btn_hud_add_joystick"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="5dp"
                    android:gravity="center"
                    android:paddingHorizontal="9dp"
                    android:background="@drawable/btn_zyrox_secondary"
                    android:text="@string/zyrox_hud_add_joy"
                    android:textColor="@color/zyrox_text_primary"
                    android:textSize="9.5sp"
                    android:fontFamily="@font/minecraft_pixel"
                    app:fontFamily="@font/minecraft_pixel" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="18dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@color/zyrox_divider" />

                <TextView
                    android:id="@+id/btn_hud_load"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:paddingHorizontal="9dp"
                    android:background="@drawable/btn_zyrox_secondary"
                    android:text="@string/zyrox_hud_load"
                    android:textColor="@color/zyrox_text_secondary"
                    android:textSize="9.5sp"
                    android:fontFamily="@font/minecraft_pixel"
                    app:fontFamily="@font/minecraft_pixel" />

                <TextView
                    android:id="@+id/btn_hud_save"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="5dp"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:background="@drawable/btn_zyrox_play"
                    android:text="@string/zyrox_hud_save"
                    android:textColor="@color/zyrox_text_primary"
                    android:textSize="9.5sp"
                    android:fontFamily="@font/minecraft_pixel"
                    app:fontFamily="@font/minecraft_pixel" />

                <!-- Preserved original ID: opens full drawer with Set Default & Share JSON -->
                <TextView
                    android:id="@+id/drawer_button"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="5dp"
                    android:gravity="center"
                    android:paddingHorizontal="9dp"
                    android:background="@drawable/btn_zyrox_secondary"
                    android:text="@string/zyrox_hud_more"
                    android:textColor="@color/zyrox_amber"
                    android:textSize="9.5sp"
                    android:fontFamily="@font/minecraft_pixel"
                    app:fontFamily="@font/minecraft_pixel" />

                <TextView
                    android:id="@+id/btn_hud_exit"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="5dp"
                    android:gravity="center"
                    android:paddingHorizontal="9dp"
                    android:background="@drawable/btn_zyrox_danger"
                    android:text="@string/zyrox_hud_exit"
                    android:textColor="@color/zyrox_danger"
                    android:textSize="9.5sp"
                    android:fontFamily="@font/minecraft_pixel"
                    app:fontFamily="@font/minecraft_pixel" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- MINIMIZED FLOATING AMBER PILL BUTTON (Restores toolbar on tap) -->
        <TextView
            android:id="@+id/btn_hud_expand"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:background="@drawable/btn_zyrox_play"
            android:elevation="16dp"
            android:text="@string/zyrox_brand_title"
            android:textColor="@color/zyrox_text_primary"
            android:textSize="10sp"
            android:letterSpacing="0.08"
            android:fontFamily="@font/minecraft_pixel"
            app:fontFamily="@font/minecraft_pixel"
            android:visibility="gone" />
    </FrameLayout>

    <!-- RIGHT SLIDE-OVER PRESETS & EXPORT GLASS DRAWER -->
    <ListView
        android:id="@+id/customctrl_navigation_view"
        android:layout_width="230dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/bg_zyrox_glass_modal"
        android:divider="@color/zyrox_divider"
        android:dividerHeight="1dp"
        android:padding="8dp"
        android:fitsSystemWindows="false" />

</androidx.drawerlayout.widget.DrawerLayout>
