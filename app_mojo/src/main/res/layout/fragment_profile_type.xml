<?xml version="1.0" encoding="utf-8"?>
<!-- Zyrox New Instance Studio — 2-Column Horizontal Glass Selector -->
<com.kdt.DefocusableScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2E0D0A08"
    android:padding="12dp"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Left Column: Vanilla & Performance -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:orientation="vertical"
            android:background="@drawable/bg_zyrox_glass_card"
            android:padding="14dp">

            <TextView
                android:id="@+id/title_textview"
                style="@style/Zyrox.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:text="@string/create_profile_vanilla_like_versions" />

            <View
                android:id="@+id/view"
                style="@style/ThickDivider"
                android:layout_marginVertical="8dp" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/vanilla_profile"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/create_instance_vanilla" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/optifine_profile"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/btn_zyrox_secondary"
                android:textColor="@color/zyrox_text_primary"
                android:textSize="11sp"
                android:fontFamily="@font/minecraft_pixel"
                app:fontFamily="@font/minecraft_pixel"
                android:text="@string/mod_dl_install_optifine" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/modded_profile_modpack"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/btn_zyrox_secondary"
                android:textColor="@color/zyrox_amber"
                android:textSize="11sp"
                android:fontFamily="@font/minecraft_pixel"
                app:fontFamily="@font/minecraft_pixel"
                android:text="@string/modpack_install_instance_button" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/modded_profile_bta"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/btn_zyrox_secondary"
                android:textColor="@color/zyrox_text_secondary"
                android:textSize="11sp"
                android:fontFamily="@font/minecraft_pixel"
                app:fontFamily="@font/minecraft_pixel"
                android:text="@string/create_bta_instance" />
        </LinearLayout>

        <!-- Right Column: Modloaders (Fabric, Forge, NeoForge, Quilt, Legacy Fabric) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="vertical"
            android:background="@drawable/bg_zyrox_glass_card"
            android:padding="14dp">

            <TextView
                android:id="@+id/title_modded_textview"
                style="@style/Zyrox.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:text="@string/create_profile_modded_versions" />

            <View
                android:id="@+id/view_modded"
                style="@style/ThickDivider"
                android:layout_marginVertical="8dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/modded_profile_fabric"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/btn_zyrox_secondary"
                android:textColor="@color/zyrox_text_primary"
                android:textSize="11sp"
                android:fontFamily="@font/minecraft_pixel"
                app:fontFamily="@font/minecraft_pixel"
                android:text="@string/modloader_dl_install_fabric_instance" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/modded_profile_forge"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/btn_zyrox_secondary"
                android:textColor="@color/zyrox_text_primary"
                android:textSize="11sp"
                android:fontFamily="@font/minecraft_pixel"
                app:fontFamily="@font/minecraft_pixel"
                android:text="@string/modloader_dl_install_forge_instance" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/modded_profile_neoforge"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/btn_zyrox_secondary"
                android:textColor="@color/zyrox_text_primary"
                android:textSize="11sp"
                android:fontFamily="@font/minecraft_pixel"
                app:fontFamily="@font/minecraft_pixel"
                android:text="@string/modloader_dl_install_neoforge_instance" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/modded_profile_quilt"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/btn_zyrox_secondary"
                android:textColor="@color/zyrox_text_primary"
                android:textSize="11sp"
                android:fontFamily="@font/minecraft_pixel"
                app:fontFamily="@font/minecraft_pixel"
                android:text="@string/modloader_dl_install_quilt_instance" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/modded_profile_legacy_fabric"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/btn_zyrox_secondary"
                android:textColor="@color/zyrox_text_secondary"
                android:textSize="11sp"
                android:fontFamily="@font/minecraft_pixel"
                app:fontFamily="@font/minecraft_pixel"
                android:text="@string/modloader_dl_install_legacy_fabric_instance" />
        </LinearLayout>

    </LinearLayout>
</com.kdt.DefocusableScrollView>
