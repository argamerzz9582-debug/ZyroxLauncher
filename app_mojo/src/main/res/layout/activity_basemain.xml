<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_height="match_parent"
	android:layout_width="match_parent"
	android:layout_alignParentRight="true"
	android:id="@+id/main_drawer_options"
	android:background="@drawable/no_focus_shown"
	android:keepScreenOn="true">

	<FrameLayout
		android:id="@+id/content_frame"
		android:layout_width="match_parent"
		android:layout_height="match_parent">

		<git.artdeell.mojo.input.ControlLayout
			android:id="@+id/main_control_layout"
			android:layout_width="match_parent"
			android:layout_height="match_parent">

			<git.artdeell.mojo.game.GameView
				android:id="@+id/main_game_render_view"
				android:layout_width="fill_parent"
				android:layout_height="fill_parent"
				android:defaultFocusHighlightEnabled="false"
				android:focusable="true"
				android:descendantFocusability="blocksDescendants"
                tools:ignore="UnusedAttribute">

				<git.artdeell.mojo.game.GameCursorView
					android:layout_height="match_parent"
					android:layout_width="match_parent"
					android:orientation="vertical"
					android:id="@+id/main_cursorview"
					android:focusable="false"
					android:translationZ="1dp"
					android:visibility="gone"
					app:defaultCursorDrawable="@drawable/ic_mouse_pointer"/>

			</git.artdeell.mojo.game.GameView>

			<!-- Seamless Animated Minecraft Sunset Mountain Loading Backdrop (strictly behind all touch controls) -->
			<FrameLayout
				android:id="@+id/main_loading_screen"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:clickable="false"
				android:focusable="false"
				android:elevation="0dp"
				android:visibility="visible">

				<git.artdeell.mojo.ui.MinecraftLoadingLandscapeView
					android:id="@+id/main_loading_landscape"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:clickable="false"
					android:focusable="false" />

				<LinearLayout
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginBottom="16dp"
					android:layout_gravity="center"
					android:gravity="center"
					android:clickable="false"
					android:focusable="false"
					android:paddingHorizontal="20dp"
					android:paddingVertical="12dp"
					android:orientation="vertical">

					<ProgressBar
						android:id="@+id/main_loading_screen_progress"
						android:layout_width="26dp"
						android:layout_height="26dp"
						android:indeterminate="true"
						android:indeterminateTint="@color/zyrox_amber_stroke" />

					<TextView
						android:id="@+id/main_loading_screen_text"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="8dp"
						android:text="@string/zyrox_loading_preparing"
						android:textColor="@color/zyrox_text_primary"
						android:shadowColor="#E6090705"
						android:shadowDx="0"
						android:shadowDy="2"
						android:shadowRadius="6"
						android:textSize="16sp" />

					<TextView
						android:id="@+id/main_loading_screen_warning"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="3dp"
						android:text="@string/loading_screen_warning"
						android:textColor="#D9E7DFD5"
						android:shadowColor="#E6090705"
						android:shadowDx="0"
						android:shadowDy="1"
						android:shadowRadius="5"
						android:textSize="12sp" />
				</LinearLayout>
			</FrameLayout>

			<git.artdeell.mojo.input.keyboard.TouchCharInput
				android:id="@+id/mainTouchCharInput"
				android:layout_width="1dp"
				android:layout_height="1dp"
				android:background="@android:color/darker_gray"
				android:ems="10"
				android:imeOptions="flagNoFullscreen|flagNoExtractUi|flagNoPersonalizedLearning|actionDone"
				android:inputType="textFilter|textImeMultiLine|textAutoComplete|textAutoCorrect"
				tools:ignore="TouchTargetSizeCheck" />

			<git.artdeell.mojo.input.handleview.DrawerPullButton
				android:id="@+id/drawer_button"
				android:layout_width="40dp"
				android:layout_height="20dp"
				android:padding="8dp"
				android:elevation="10dp"
				android:layout_gravity="center_horizontal"/>
			<git.artdeell.mojo.input.mouse.HotbarView
				android:id="@+id/hotbar_view"
				android:layout_width="0px"
				android:layout_height="0px"/>

		</git.artdeell.mojo.input.ControlLayout>

		<com.kdt.LoggerView
			android:id="@+id/mainLoggerView"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:visibility="gone"
			/>

	</FrameLayout>

	<ListView
		android:layout_width="200dp"
		android:layout_height="match_parent"
		android:layout_gravity="right"
		android:background="?attr/colorBackgroundFloating"
		android:fitsSystemWindows="false"
		android:id="@+id/main_navigation_view"/>

</androidx.drawerlayout.widget.DrawerLayout>

