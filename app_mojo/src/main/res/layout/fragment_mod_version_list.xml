<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#300B1326"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_zyrox_glass_card"
        android:padding="14dp">

        <TextView
            android:id="@+id/title_textview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/forge_dl_select_version"
            android:textColor="@color/zyrox_text_primary"
            android:textSize="14sp"
            android:letterSpacing="0.08"
            android:fontFamily="@font/minecraft_pixel"
            app:fontFamily="@font/minecraft_pixel" />

        <View
            android:id="@+id/view"
            style="@style/ThickDivider"
            android:layout_marginVertical="8dp" />

        <!-- Modern Recommendation & Scraper Fallback Card (Sodium + Iris on MC 1.16+ or scrape failure) -->
        <LinearLayout
            android:id="@+id/mod_dl_sodium_iris_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_zyrox_glass_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_sodium_iris_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MODERN MOBILE SHADERS + 2X FPS"
                    android:textColor="@color/zyrox_firefly_gold"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_sodium_iris_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="On Minecraft 1.16+, Sodium + Iris delivers higher FPS, faster chunk loading, and full shader compatibility than OptiFine."
                    android:textColor="@color/zyrox_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_install_sodium_iris"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/btn_zyrox_play"
                android:paddingHorizontal="12dp"
                android:text="Install Sodium + Iris (Recommended)"
                android:textAllCaps="false"
                android:textColor="@color/zyrox_lg_text"
                android:textSize="11sp" />
        </LinearLayout>

        <ExpandableListView
            android:id="@+id/mod_dl_expandable_version_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@color/zyrox_divider"
            android:dividerHeight="1dp"
            android:scrollbarThumbVertical="@color/zyrox_amber" />

        <LinearLayout
            android:id="@+id/mod_dl_retry_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:background="@drawable/bg_zyrox_badge_danger"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/modloader_dl_failed_to_load_list"
                android:textColor="@color/zyrox_danger"
                android:textSize="12sp" />

            <Button
                android:id="@+id/forge_installer_retry_button"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="@string/global_retry" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/mod_dl_list_progress"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="6dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/zyrox_amber" />
    </LinearLayout>
</FrameLayout>
