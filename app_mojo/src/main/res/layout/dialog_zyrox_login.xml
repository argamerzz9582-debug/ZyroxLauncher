<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/zyrox_vault_modal"
    android:layout_width="550dp"
    android:layout_height="match_parent"
    android:maxHeight="320dp"
    android:layout_gravity="center"
    android:orientation="horizontal"
    android:background="@drawable/bg_zyrox_glass_card"
    android:padding="14dp"
    android:elevation="0dp"
    android:baselineAligned="false">

    <!-- LEFT COLUMN: 3D Isometric Skin Preview, Status Badge & Account Switcher -->
    <LinearLayout
        android:layout_width="176dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_zyrox_glass_card_soft"
        android:padding="10dp">

        <FrameLayout
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/bg_zyrox_input"
            android:padding="6dp">

            <ImageView
                android:id="@+id/iv_vault_skin_head"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_default_steve_head"
                android:contentDescription="@string/zyrox_title_account_vault" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_vault_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:text="@string/main_add_account"
            android:textColor="@color/zyrox_text_primary"
            android:textSize="11.5sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:fontFamily="@font/minecraft_pixel"
            app:fontFamily="@font/minecraft_pixel"
            tools:text="ZyroxPlayer" />

        <TextView
            android:id="@+id/tv_vault_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_zyrox_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="@string/zyrox_badge_no_account"
            android:textColor="@color/zyrox_amber"
            android:textSize="8.5sp"
            android:letterSpacing="0.06"
            android:singleLine="true"
            android:fontFamily="@font/minecraft_pixel"
            app:fontFamily="@font/minecraft_pixel" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="7dp"
            android:background="@color/zyrox_divider" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_vault_accounts"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/tv_vault_empty_accounts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingVertical="6dp"
            android:text="@string/no_saved_accounts"
            android:textColor="@color/zyrox_text_muted"
            android:textSize="10sp"
            android:fontFamily="sans-serif"
            android:visibility="gone" />
    </LinearLayout>

    <!-- RIGHT COLUMN: Microsoft OAuth, Ely.by OAuth & Offline Profile Creator -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/zyrox_title_account_vault"
                android:textColor="@color/zyrox_amber"
                android:textSize="13.5sp"
                android:letterSpacing="0.08"
                android:fontFamily="@font/minecraft_pixel"
                app:fontFamily="@font/minecraft_pixel" />

            <!-- Primary Microsoft Login CTA -->
            <com.kdt.mcgui.MineButton
                android:id="@+id/button_microsoft_authentication"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:drawableStart="@drawable/ic_auth_ms"
                android:drawablePadding="10dp"
                android:paddingHorizontal="14dp"
                android:gravity="center"
                android:text="@string/zyrox_microsoft_login"
                android:textColor="@color/zyrox_text_primary"
                android:textSize="12sp" />

            <!-- Secondary Ely.by Login Button -->
            <com.kdt.mcgui.MineButton
                android:id="@+id/button_elyby_authentication"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="7dp"
                android:tag="custom_bg"
                android:background="@drawable/btn_zyrox_secondary"
                android:drawableStart="@drawable/ic_auth_elyby"
                android:drawablePadding="10dp"
                android:paddingHorizontal="14dp"
                android:gravity="center"
                android:text="@string/zyrox_elyby_login"
                android:textColor="@color/zyrox_text_primary"
                android:textSize="11sp" />

            <!-- OR OFFLINE DIVIDER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/zyrox_divider" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:text="@string/zyrox_or_offline"
                    android:textColor="@color/zyrox_text_muted"
                    android:textSize="8.5sp"
                    android:letterSpacing="0.06"
                    android:fontFamily="@font/minecraft_pixel"
                    app:fontFamily="@font/minecraft_pixel" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/zyrox_divider" />
            </LinearLayout>

            <!-- Offline Username Input -->
            <com.kdt.mcgui.MineEditText
                android:id="@+id/login_edit_email"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_zyrox_input"
                android:paddingHorizontal="12dp"
                android:hint="@string/zyrox_offline_hint"
                android:textColor="@color/zyrox_text_primary"
                android:textColorHint="@color/zyrox_text_muted"
                android:textSize="13sp"
                android:singleLine="true"
                android:maxLength="16"
                android:imeOptions="actionDone|flagNoExtractUi"
                android:inputType="textNoSuggestions|textVisiblePassword" />

            <!-- Add Offline Account Button -->
            <com.kdt.mcgui.MineButton
                android:id="@+id/button_local_authentication"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="8dp"
                android:tag="custom_bg"
                android:background="@drawable/btn_zyrox_secondary"
                android:gravity="center"
                android:text="@string/zyrox_add_offline"
                android:textColor="@color/zyrox_amber"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
