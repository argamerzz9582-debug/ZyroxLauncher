<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/_280sdp"
    android:layout_height="wrap_content"
    android:layout_marginVertical="10dp"
    android:layout_marginHorizontal="8dp"
    android:layout_gravity="center_vertical"
    android:orientation="vertical"
    android:background="@drawable/bg_zyrox_ingame_drawer"
    android:padding="13dp"
    android:elevation="16dp">

    <TextView
        android:id="@+id/side_dialog_title_textview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="6dp"
        android:paddingVertical="6dp"
        android:textColor="@color/zyrox_lg_text"
        android:textSize="13sp"
        android:textAllCaps="true"
        android:letterSpacing="0.08"
        android:shadowColor="@color/zyrox_lg_shadow"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:fontFamily="@font/noto_sans_bold"
        app:fontFamily="@font/noto_sans_bold"
        android:visibility="gone"
        tools:text="QUICK SETTINGS"
        tools:visibility="visible" />

    <View
        android:id="@+id/side_dialog_title_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="6dp"
        android:background="@color/zyrox_divider"
        android:visibility="gone"
        tools:visibility="visible" />

    <com.kdt.DefocusableScrollView
        android:id="@+id/side_dialog_scrollview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:overScrollMode="ifContentScrolls">
        <!-- Property sheet content inflated here -->
    </com.kdt.DefocusableScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:background="@color/zyrox_divider" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp">

        <Button
            android:id="@+id/side_dialog_start_button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minHeight="36dp"
            android:layout_alignParentStart="true"
            android:paddingHorizontal="16dp"
            android:background="@drawable/btn_zyrox_secondary"
            android:textColor="@color/zyrox_lg_text"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:letterSpacing="0.05"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:fontFamily="@font/noto_sans_bold"
            app:fontFamily="@font/noto_sans_bold"
            android:visibility="gone"
            tools:text="CANCEL"
            tools:visibility="visible" />

        <Button
            android:id="@+id/side_dialog_end_button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minHeight="36dp"
            android:layout_alignParentEnd="true"
            android:paddingHorizontal="18dp"
            android:background="@drawable/btn_zyrox_play"
            android:textColor="@color/zyrox_lg_text"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:letterSpacing="0.05"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:fontFamily="@font/noto_sans_bold"
            app:fontFamily="@font/noto_sans_bold"
            android:visibility="gone"
            tools:text="APPLY"
            tools:visibility="visible"
            tools:ignore="RelativeOverlap" />
    </RelativeLayout>
</LinearLayout>
