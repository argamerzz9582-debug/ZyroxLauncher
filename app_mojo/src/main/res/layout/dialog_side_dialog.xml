<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/_280sdp"
    android:layout_height="wrap_content"
    android:layout_marginVertical="10dp"
    android:layout_gravity="center_vertical"
    android:orientation="vertical"
    android:background="@drawable/bg_zyrox_glass_modal"
    android:padding="10dp"
    android:elevation="16dp">

    <TextView
        android:id="@+id/side_dialog_title_textview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="6dp"
        android:paddingVertical="6dp"
        android:textColor="@color/zyrox_amber"
        android:textSize="13sp"
        android:letterSpacing="0.06"
        android:fontFamily="@font/minecraft_pixel"
        app:fontFamily="@font/minecraft_pixel"
        android:visibility="gone"
        tools:text="BUTTON INSPECTOR"
        tools:visibility="visible" />

    <View
        android:id="@+id/side_dialog_title_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="4dp"
        android:background="@color/zyrox_glass_border_mid"
        android:visibility="gone"
        tools:visibility="visible" />

    <com.kdt.DefocusableScrollView
        android:id="@+id/side_dialog_scrollview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">
        <!-- Property sheet content inflated here -->
    </com.kdt.DefocusableScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:background="@color/zyrox_divider" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/side_dialog_start_button"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:minHeight="34dp"
            android:layout_alignParentStart="true"
            android:paddingHorizontal="14dp"
            android:background="@drawable/btn_zyrox_secondary"
            android:textColor="@color/zyrox_text_secondary"
            android:textSize="10.5sp"
            android:fontFamily="@font/minecraft_pixel"
            app:fontFamily="@font/minecraft_pixel"
            android:visibility="gone"
            tools:text="CANCEL"
            tools:visibility="visible" />

        <Button
            android:id="@+id/side_dialog_end_button"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:minHeight="34dp"
            android:layout_alignParentEnd="true"
            android:paddingHorizontal="16dp"
            android:background="@drawable/btn_zyrox_play"
            android:textColor="@color/zyrox_text_primary"
            android:textSize="10.5sp"
            android:fontFamily="@font/minecraft_pixel"
            app:fontFamily="@font/minecraft_pixel"
            android:visibility="gone"
            tools:text="APPLY"
            tools:visibility="visible"
            tools:ignore="RelativeOverlap" />
    </RelativeLayout>
</LinearLayout>
