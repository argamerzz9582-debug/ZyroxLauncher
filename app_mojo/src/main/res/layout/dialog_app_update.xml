<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/zyrox_update_modal_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_zyrox_glass_modal"
    android:orientation="vertical"
    android:paddingHorizontal="18dp"
    android:paddingVertical="14dp"
    tools:ignore="HardcodedText">

    <!-- Header Row: Zyrox Crystal Badge + Title + Current -> New Version Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="10dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_zyrox_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_update_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/noto_sans_bold"
                android:maxLines="1"
                android:text="What's New in Zyrox Launcher"
                android:textColor="@color/zyrox_text_primary"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_update_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/zyrox_text_muted"
                android:textSize="10.5sp"
                tools:text="65.1 MB  ·  arm64-v8a  ·  SHA-256 Verified" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_update_version_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_zyrox_badge_info"
            android:fontFamily="@font/noto_sans_bold"
            android:paddingHorizontal="9dp"
            android:paddingVertical="4dp"
            android:singleLine="true"
            android:textColor="@color/zyrox_firefly_gold"
            android:textSize="10.5sp"
            android:textStyle="bold"
            tools:text="v2.4.0 → v2.5.0" />
    </LinearLayout>

    <!-- Scrollable Formatted Markdown Changelog Container -->
    <ScrollView
        android:id="@+id/sv_update_changelog"
        android:layout_width="match_parent"
        android:layout_height="156dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_zyrox_glass_card"
        android:fadeScrollbars="false"
        android:fillViewport="true"
        android:paddingHorizontal="12dp"
        android:paddingVertical="9dp">

        <TextView
            android:id="@+id/tv_update_changelog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2.5dp"
            android:textColor="@color/zyrox_text_secondary"
            android:textSize="11.5sp"
            tools:text="• Full-HD 1080p live backgrounds\n• Instant Modrinth dependency auto-fix" />
    </ScrollView>

    <!-- Live In-App APK Download Progress Strip (visible during download/verification) -->
    <LinearLayout
        android:id="@+id/layout_update_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_zyrox_glass_card_soft"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_update_progress_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Downloading update…"
                android:textColor="@color/zyrox_text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_update_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:singleLine="true"
                android:textColor="@color/zyrox_firefly_gold"
                android:textSize="10.5sp"
                android:textStyle="bold"
                tools:text="8.4 MB/s" />

            <TextView
                android:id="@+id/tv_update_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:singleLine="true"
                android:textColor="@color/zyrox_sakura"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="64%" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pb_update_download"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/bg_zyrox_loading_bar" />
    </LinearLayout>

    <!-- Action Bar: Skip Version | Later | Update Now -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_update_skip"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:background="@drawable/btn_zyrox_secondary"
            android:paddingHorizontal="12dp"
            android:text="Skip Version"
            android:textAllCaps="false"
            android:textColor="@color/zyrox_text_secondary"
            android:textSize="11sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btn_update_later"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/btn_zyrox_secondary"
            android:paddingHorizontal="14dp"
            android:text="Later"
            android:textAllCaps="false"
            android:textColor="@color/zyrox_text_primary"
            android:textSize="11.5sp" />

        <Button
            android:id="@+id/btn_update_now"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/btn_zyrox_play"
            android:paddingHorizontal="18dp"
            android:text="Update Now"
            android:textAllCaps="false"
            android:textColor="@color/zyrox_lg_text"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
