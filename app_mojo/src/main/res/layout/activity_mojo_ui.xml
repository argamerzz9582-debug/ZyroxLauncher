<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/zyrox_root_shell"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@color/zyrox_bg_base">

    <!-- Global 100% Edge-to-Edge Animated Minecraft Shader / Video Background + Optical Vignette -->
    <git.artdeell.mojo.ui.ZyroxShaderBackgroundView
        android:id="@+id/zyrox_shader_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Global Translucent Crystal-Glass Sub-Page Header Bar (hidden on Home Hub, shown on sub-pages) -->
    <LinearLayout
        android:id="@+id/zyrox_global_header"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_zyrox_header_bar"
        android:paddingHorizontal="14dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <TextView
            android:id="@+id/btn_zyrox_back"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:paddingHorizontal="11dp"
            android:background="@drawable/bg_zyrox_action_tile"
            android:text="@string/zyrox_back"
            android:textColor="@color/zyrox_text_primary"
            android:textSize="11sp"
            android:letterSpacing="0.06"
            android:shadowColor="#BF090705"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/minecraft_pixel"
            app:fontFamily="@font/minecraft_pixel" />

        <View
            android:layout_width="1dp"
            android:layout_height="18dp"
            android:layout_marginHorizontal="10dp"
            android:background="@color/zyrox_divider" />

        <TextView
            android:id="@+id/tv_zyrox_page_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/zyrox_title_instance_studio"
            android:textColor="@color/zyrox_text_primary"
            android:textSize="13.5sp"
            android:letterSpacing="0.08"
            android:shadowColor="#BF090705"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:singleLine="true"
            android:ellipsize="end"
            android:fontFamily="@font/minecraft_pixel"
            app:fontFamily="@font/minecraft_pixel" />

        <!-- Live inline task indicator inside Global Header -->
        <TextView
            android:id="@+id/tv_zyrox_header_tasks"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:paddingHorizontal="9dp"
            android:gravity="center"
            android:background="@drawable/bg_zyrox_badge"
            android:textColor="@color/zyrox_amber_stroke"
            android:textSize="9sp"
            android:fontFamily="@font/minecraft_pixel"
            app:fontFamily="@font/minecraft_pixel"
            android:visibility="gone"
            tools:text="1 TASK"
            tools:visibility="visible" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_zyrox_top_action"
            android:layout_width="wrap_content"
            android:layout_height="31dp"
            android:minWidth="112dp"
            android:layout_marginEnd="8dp"
            android:paddingHorizontal="12dp"
            android:background="@drawable/btn_zyrox_play"
            android:text="@string/zyrox_new_instance"
            android:textColor="@color/zyrox_text_primary"
            android:textSize="10sp"
            android:letterSpacing="0.06"
            android:shadowColor="#BF120804"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:fontFamily="@font/minecraft_pixel"
            app:fontFamily="@font/minecraft_pixel"
            android:visibility="gone"
            tools:visibility="visible" />

        <ImageButton
            android:id="@+id/setting_button"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_zyrox_action_tile"
            android:src="@drawable/ic_px_home"
            app:tint="@color/zyrox_amber"
            android:scaleType="fitCenter"
            android:padding="7dp"
            android:contentDescription="@string/zyrox_home" />
    </LinearLayout>

    <!-- Slim Amber Indeterminate Activity Progress Strip below Global Header -->
    <ProgressBar
        android:id="@+id/zyrox_header_progress"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/zyrox_amber"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/zyrox_global_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Main Dynamic Screen Container (100% edge-to-edge on Home Hub) -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_fragment"
        android:name="git.artdeell.mojo.fragments.MainMenuFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/zyrox_global_header"
        app:layout_constraintBottom_toTopOf="@id/progress_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Persistent Ultra-Transparent Crystal Account Pill docked inside Home Hub Right Panel
         (zero elevation shadow box; stays mounted so auth ExtraListeners persist across screens) -->
    <LinearLayout
        android:id="@+id/zyrox_account_dock_card"
        android:layout_width="258dp"
        android:layout_height="42dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.kdt.mcgui.AccountSpinner
            android:id="@+id/account_spinner"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:dropDownWidth="258dp"
            android:dropDownVerticalOffset="45dp" />

        <ImageButton
            android:id="@+id/btn_open_account_vault"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:background="@drawable/btn_zyrox_secondary"
            android:src="@drawable/ic_add"
            app:tint="@color/zyrox_amber_stroke"
            android:scaleType="centerInside"
            android:padding="9dp"
            android:contentDescription="@string/main_add_account" />
    </LinearLayout>

    <!-- Global Expandable Live Task & Download Progress Bar -->
    <com.kdt.mcgui.ProgressLayout
        android:id="@+id/progress_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="6dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
