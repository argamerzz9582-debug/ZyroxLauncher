<?xml version="1.0" encoding="utf-8"?>
<!-- Page 3: Zyrox Modrinth & Modpack Store — Filter Header + 2-Col Grid + Slide-Over Version Drawer -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#300B1326">

    <!-- Top Search + Content Mode Tabs + Platform Toggle + Chip Filter Bar -->
    <LinearLayout
        android:id="@+id/search_mod_overlay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:background="@drawable/bg_zyrox_glass_card"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Row 0: All-in-One Content Type Tabs + 1-Click FPS Boost Pack -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tab_store_modpacks"
                    style="@style/Zyrox.FilterChip"
                    android:text="@string/zyrox_store_tab_modpacks" />

                <TextView
                    android:id="@+id/tab_store_mods"
                    style="@style/Zyrox.FilterChip"
                    android:text="@string/zyrox_store_tab_mods" />

                <TextView
                    android:id="@+id/tab_store_shaders"
                    style="@style/Zyrox.FilterChip"
                    android:text="@string/zyrox_store_tab_shaders" />

                <TextView
                    android:id="@+id/tab_store_resourcepacks"
                    style="@style/Zyrox.FilterChip"
                    android:text="@string/zyrox_store_tab_resources" />

                <TextView
                    android:id="@+id/btn_store_fps_boost"
                    style="@style/Zyrox.FilterChip"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/zyrox_firefly_gold"
                    android:text="@string/zyrox_store_fps_boost" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Row 1: Search Input + Platform Pills + Version Filter -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/search_mod_edittext"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_zyrox_input"
                android:hint="@string/zyrox_search_mods_hint"
                android:textColor="@color/zyrox_text_primary"
                android:textColorHint="@color/zyrox_text_muted"
                android:textSize="12sp"
                android:singleLine="true"
                android:imeOptions="flagNoExtractUi|actionSearch"
                android:inputType="text"
                android:paddingHorizontal="12dp" />

            <!-- Platform Toggle (Modrinth / CurseForge) -->
            <TextView
                android:id="@+id/btn_platform_all"
                style="@style/Zyrox.FilterChip"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="4dp"
                android:text="@string/zyrox_platform_all" />

            <TextView
                android:id="@+id/btn_platform_modrinth"
                style="@style/Zyrox.FilterChip"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:text="@string/zyrox_platform_modrinth" />

            <TextView
                android:id="@+id/btn_platform_curseforge"
                style="@style/Zyrox.FilterChip"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:text="@string/zyrox_platform_curseforge" />

            <ImageButton
                android:id="@+id/search_mod_filter"
                android:layout_width="36dp"
                android:layout_height="34dp"
                android:background="@drawable/btn_zyrox_secondary"
                android:src="@drawable/ic_filter"
                app:tint="@color/zyrox_amber"
                android:scaleType="centerInside"
                android:padding="7dp"
                android:contentDescription="@string/profiles_profile_version" />
        </LinearLayout>

        <!-- Row 2: Horizontal Category & Loader Filter Pills -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/chip_filter_all"
                    style="@style/Zyrox.FilterChip"
                    android:text="@string/zyrox_chip_all" />

                <TextView
                    android:id="@+id/chip_filter_optimization"
                    style="@style/Zyrox.FilterChip"
                    android:text="@string/zyrox_chip_optimization" />

                <TextView
                    android:id="@+id/chip_filter_modpacks"
                    style="@style/Zyrox.FilterChip"
                    android:text="@string/zyrox_chip_modpacks" />

                <TextView
                    android:id="@+id/chip_filter_fabric"
                    style="@style/Zyrox.FilterChip"
                    android:text="@string/zyrox_chip_fabric" />

                <TextView
                    android:id="@+id/chip_filter_forge"
                    style="@style/Zyrox.FilterChip"
                    android:text="@string/zyrox_chip_forge" />

                <TextView
                    android:id="@+id/chip_filter_quilt"
                    style="@style/Zyrox.FilterChip"
                    android:text="@string/zyrox_chip_quilt" />

                <TextView
                    android:id="@+id/chip_filter_neoforge"
                    style="@style/Zyrox.FilterChip"
                    android:text="@string/zyrox_chip_neoforge" />

                <TextView
                    android:id="@+id/chip_filter_mods"
                    style="@style/Zyrox.FilterChip"
                    android:text="@string/zyrox_chip_shaders" />
            </LinearLayout>
        </HorizontalScrollView>

        <ProgressBar
            android:id="@+id/search_mod_progressbar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="5dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/zyrox_amber"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 2-Column Horizontal Glass Mod Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/search_mod_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingHorizontal="6dp"
        android:paddingTop="6dp"
        android:paddingBottom="10dp"
        android:clipToPadding="false"
        android:scrollbars="vertical"
        android:scrollbarThumbVertical="@color/zyrox_amber"
        app:layout_constraintTop_toBottomOf="@id/search_mod_overlay"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/search_mod_status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="18dp"
        android:paddingVertical="10dp"
        android:background="@drawable/bg_zyrox_glass_card"
        android:textColor="@color/zyrox_text_secondary"
        android:textSize="12sp"
        android:fontFamily="@font/minecraft_pixel"
        app:fontFamily="@font/minecraft_pixel"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/search_mod_list"
        app:layout_constraintEnd_toEndOf="@id/search_mod_list"
        app:layout_constraintStart_toStartOf="@id/search_mod_list"
        app:layout_constraintTop_toTopOf="@id/search_mod_list" />

    <!-- Preserved original ID for local modpack import (triggered via Global Header action too) -->
    <com.kdt.mcgui.MineButton
        android:id="@+id/mineButton_import_local_modpack"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:visibility="gone"
        android:text="@string/import_local_modpack"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Scrim + Right-Side Slide-Over Glass Version Drawer -->
    <View
        android:id="@+id/zyrox_version_drawer_scrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/zyrox_bg_overlay"
        android:elevation="12dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/zyrox_version_drawer"
        android:layout_width="320dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="@drawable/bg_zyrox_glass_modal"
        android:padding="14dp"
        android:elevation="16dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_drawer_mod_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/zyrox_text_primary"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="@font/minecraft_pixel"
                app:fontFamily="@font/minecraft_pixel"
                tools:text="FABULOUSLY OPTIMIZED" />

            <ImageButton
                android:id="@+id/btn_close_version_drawer"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_zyrox_nav_item"
                android:src="@drawable/ic_px_close"
                app:tint="@color/zyrox_amber"
                android:padding="5dp"
                android:scaleType="fitCenter" 
            android:contentDescription="@string/zyrox_back"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_drawer_mod_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/zyrox_text_secondary"
            android:textSize="11sp"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="Select a compatible Minecraft version below for one-tap install." />

        <View
            style="@style/ThickDivider"
            android:layout_marginVertical="8dp" />

        <TextView
            style="@style/Zyrox.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/zyrox_select_version_title" />

        <ProgressBar
            android:id="@+id/pb_drawer_versions"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginVertical="16dp"
            android:indeterminateTint="@color/zyrox_amber"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_drawer_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/search_modpack_download_error"
            android:textColor="@color/zyrox_danger"
            android:textSize="11.5sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_drawer_versions"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical"
            android:scrollbarThumbVertical="@color/zyrox_amber" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
