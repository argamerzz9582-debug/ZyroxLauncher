<?xml version="1.0" encoding="utf-8"?>
<!-- Page 2: Zyrox Instance & Profile Studio — 2-Column Horizontal Split -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#660D0B0A"
    android:padding="12dp">

    <!-- LEFT RAIL (230dp): Saved Profiles / Instances + Quick + NEW Button -->
    <LinearLayout
        android:id="@+id/zyrox_instance_left_rail"
        android:layout_width="230dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="@drawable/bg_zyrox_glass_card"
        android:padding="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            style="@style/Zyrox.SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="4dp"
            android:paddingBottom="6dp"
            android:text="@string/zyrox_saved_profiles" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="6dp"
            android:background="@color/zyrox_divider" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/zyrox_instance_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical"
            android:scrollbarThumbVertical="@color/zyrox_amber"
            android:clipToPadding="false" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_rail_new_instance"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_zyrox_secondary"
            android:text="@string/zyrox_new_instance"
            android:textColor="@color/zyrox_amber"
            android:textSize="10.5sp"
            android:letterSpacing="0.06"
            android:stateListAnimator="@null"
            android:fontFamily="@font/minecraft_pixel"
            app:fontFamily="@font/minecraft_pixel" />
    </LinearLayout>

    <!-- RIGHT PANE: Scrollable Glass Instance Editor Form + Sticky Action Bar -->
    <LinearLayout
        android:id="@+id/zyrox_instance_right_pane"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:orientation="vertical"
        android:background="@drawable/bg_zyrox_glass_card"
        android:padding="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/zyrox_instance_left_rail"
        app:layout_constraintEnd_toEndOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fadeScrollbars="false"
            android:scrollbarThumbVertical="@color/zyrox_amber">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingEnd="4dp">

                <!-- Row 1: Icon Picker + Profile Name -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_zyrox_input"
                        android:padding="6dp">

                        <ImageView
                            android:id="@+id/vprof_editor_instance_icon"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            tools:src="@drawable/ic_zyrox_grass_block" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="bottom|end"
                            android:src="@drawable/ic_px_edit"
                            app:tint="@color/zyrox_amber"
                            android:background="@drawable/bg_zyrox_badge"
                            android:padding="2dp" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/vprof_editor_profile_name_sub"
                            style="@style/Zyrox.SectionLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profiles_profile_name" />

                        <EditText
                            android:id="@+id/vprof_editor_instance_name"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_zyrox_input"
                            android:hint="@string/unnamed"
                            android:textColor="@color/zyrox_text_primary"
                            android:textColorHint="@color/zyrox_text_muted"
                            android:textSize="13sp"
                            android:singleLine="true"
                            android:imeOptions="flagNoExtractUi|actionDone"
                            android:inputType="textPersonName"
                            android:paddingHorizontal="12dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 2: Minecraft Version Selector -->
                <TextView
                    android:id="@+id/textView4"
                    style="@style/Zyrox.SectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/profiles_profile_version" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/vprof_editor_version_spinner"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_zyrox_input"
                        android:hint="@string/version_select_hint"
                        android:textColor="@color/zyrox_text_primary"
                        android:textColorHint="@color/zyrox_text_muted"
                        android:paddingHorizontal="12dp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textSize="12.5sp" />

                    <Button
                        android:id="@+id/vprof_editor_version_button"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:paddingHorizontal="14dp"
                        android:background="@drawable/btn_zyrox_secondary"
                        android:textColor="@color/zyrox_amber"
                        android:text="@string/global_select" />
                </LinearLayout>

                <!-- Row 3: Graphics Renderer + Compatibility Subtitle -->
                <TextView
                    android:id="@+id/textView3"
                    style="@style/Zyrox.SectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/pedit_renderer" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_zyrox_input">

                    <Spinner
                        android:id="@+id/vprof_editor_instance_renderer"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:popupBackground="@drawable/bg_zyrox_glass_modal"
                        android:paddingEnd="28dp" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="10dp"
                        android:rotation="180"
                        android:src="@drawable/spinner_arrow"
                        app:tint="@color/zyrox_amber" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_renderer_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/zyrox_renderer_hint_default"
                    android:textColor="@color/zyrox_text_muted"
                    android:textSize="10.5sp" />

                <!-- Row 4: 2-Column Java Runtime + Control Layout -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textView2"
                            style="@style/Zyrox.SectionLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pedit_java_runtime" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_zyrox_input">

                            <Spinner
                                android:id="@+id/vprof_editor_spinner_runtime"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:popupBackground="@drawable/bg_zyrox_glass_modal"
                                android:paddingEnd="26dp" />

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_gravity="end|center_vertical"
                                android:layout_marginEnd="8dp"
                                android:rotation="180"
                                android:src="@drawable/spinner_arrow"
                                app:tint="@color/zyrox_amber" />
                        </FrameLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textView7"
                            style="@style/Zyrox.SectionLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/default_control" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:layout_marginTop="4dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/vprof_editor_ctrl_spinner"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                android:gravity="center_vertical"
                                android:background="@drawable/bg_zyrox_input"
                                android:hint="@string/use_global_default"
                                android:textColor="@color/zyrox_text_primary"
                                android:textColorHint="@color/zyrox_text_muted"
                                android:paddingHorizontal="10dp"
                                android:singleLine="true"
                                android:ellipsize="end"
                                android:textSize="11.5sp" />

                            <Button
                                android:id="@+id/vprof_editor_ctrl_button"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:minWidth="56dp"
                                android:paddingHorizontal="10dp"
                                android:background="@drawable/btn_zyrox_secondary"
                                android:textColor="@color/zyrox_amber"
                                android:textSize="10sp"
                                android:text="@string/global_select" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 5: JVM RAM Slider (live numeric badge) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        style="@style/Zyrox.SectionLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/zyrox_jvm_ram_label" />

                    <TextView
                        android:id="@+id/tv_vprof_ram_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:background="@drawable/bg_zyrox_badge"
                        android:textColor="@color/zyrox_amber"
                        android:textSize="10sp"
                        android:fontFamily="@font/minecraft_pixel"
                        app:fontFamily="@font/minecraft_pixel"
                        tools:text="2048 MB" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/vprof_ram_seekbar"
                    style="@style/MojoLauncher.SeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:layout_marginTop="2dp" />

                <!-- Row 6: JVM Launch Arguments + Shared Directory -->
                <TextView
                    android:id="@+id/textView6"
                    style="@style/Zyrox.SectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/pvc_jvmArgs" />

                <EditText
                    android:id="@+id/vprof_editor_jre_args"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_zyrox_input"
                    android:hint="@string/use_global_default"
                    android:textColor="@color/zyrox_text_primary"
                    android:textColorHint="@color/zyrox_text_muted"
                    android:imeOptions="flagNoExtractUi|actionDone"
                    android:inputType="text"
                    android:singleLine="true"
                    android:paddingHorizontal="12dp"
                    android:textSize="12sp" />

                <CheckBox
                    android:id="@+id/vprof_editor_data_checkbox_container"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_zyrox_input"
                    android:paddingHorizontal="12dp"
                    android:buttonTint="@color/zyrox_amber"
                    android:text="@string/instance_shared_data_off"
                    android:textColor="@color/zyrox_text_secondary"
                    android:textSize="11.5sp" />

            </LinearLayout>
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@color/zyrox_divider" />

        <!-- Bottom Sticky Bar inside Right Pane: Red DELETE outline on left, Glowing Amber SAVE on right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/vprof_editor_delete_button"
                android:layout_width="130dp"
                android:layout_height="match_parent"
                android:background="@drawable/btn_zyrox_danger"
                android:text="@string/zyrox_delete_instance"
                android:textColor="@color/zyrox_danger"
                android:textSize="11.5sp"
                android:letterSpacing="0.06"
                android:stateListAnimator="@null"
                android:fontFamily="@font/minecraft_pixel"
                app:fontFamily="@font/minecraft_pixel" />

            <Space
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/vprof_editor_save_button"
                android:layout_width="190dp"
                android:layout_height="match_parent"
                android:background="@drawable/btn_zyrox_play"
                android:text="@string/zyrox_save_instance"
                android:textColor="@color/zyrox_text_primary"
                android:textSize="12sp"
                android:letterSpacing="0.08"
                android:fontFamily="@font/minecraft_pixel"
                app:fontFamily="@font/minecraft_pixel" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
