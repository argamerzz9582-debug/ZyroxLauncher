<?xml version="1.0" encoding="utf-8"?>
<!-- Zyrox Home Hub (Main Dashboard) — Edge-to-Edge Fullscreen + Ultra-Transparent Crystal Glass Right Dock -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@android:color/transparent">

    <!-- 1. RIGHT CRYSTAL-GLASS CONTROL PANEL (286dp, full edge-to-edge height, true shader transparency) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/zyrox_left_dock"
        android:layout_width="286dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_zyrox_right_dock"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="7dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Reserved slot aligned 1:1 with Activity AccountSpinner Crystal Pill (42dp) -->
        <Space
            android:id="@+id/zyrox_account_slot"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Primary Translucent Luminous Amber-Crystal PLAY CTA -->
        <com.kdt.mcgui.MineButton
            android:id="@+id/play_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_zyrox_play"
            android:text="@string/main_play"
            android:textColor="@color/zyrox_text_primary"
            android:textSize="16sp"
            android:letterSpacing="0.18"
            android:textAllCaps="true"
            android:shadowColor="#CC120804"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="6"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:fontFamily="@font/minecraft_pixel"
            app:fontFamily="@font/minecraft_pixel"
            app:layout_constraintTop_toBottomOf="@id/zyrox_account_slot"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Version / Instance Selector Crystal Glass Pill directly below PLAY -->
        <LinearLayout
            android:id="@+id/zyrox_version_pill"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginTop="7dp"
            android:paddingStart="4dp"
            android:paddingEnd="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_zyrox_input"
            app:layout_constraintTop_toBottomOf="@id/play_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.kdt.mcgui.mcVersionSpinner
                android:id="@+id/mc_version_spinner"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:textColor="@color/zyrox_text_primary"
                android:shadowColor="#BF090705"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:drawableEnd="@drawable/spinner_arrow"
                app:drawableEndPadding="6dp"
                app:drawableEndSize="10dp"
                app:drawableStartIntegerScaling="true"
                app:drawableStartSize="22dp" />

            <View
                android:layout_width="1dp"
                android:layout_height="18dp"
                android:background="@color/zyrox_divider" />

            <ImageButton
                android:id="@+id/edit_profile_button"
                android:layout_width="36dp"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_px_edit"
                app:tint="@color/zyrox_amber_stroke"
                android:scaleType="centerInside"
                android:padding="9dp"
                android:contentDescription="@string/global_edit" />
        </LinearLayout>

        <!-- Tapered Luminous Champagne-Amber Glass Divider -->
        <View
            android:id="@+id/_background_display_view"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_zyrox_hero_divider"
            app:layout_constraintTop_toBottomOf="@id/zyrox_version_pill"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Symmetrical 2x3 Crystal-Glass Action Tile Grid (all 6 core features visible at once) -->
        <ScrollView
            android:id="@+id/zyrox_nav_scroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="4dp"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:fillViewport="false"
            app:layout_constraintTop_toBottomOf="@id/_background_display_view"
            app:layout_constraintBottom_toTopOf="@id/tv_zyrox_watermark"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Row 1: MODPACKS | INSTANCES -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:orientation="horizontal">

                    <com.kdt.mcgui.LauncherMenuButton
                        android:id="@+id/modpacks_button"
                        style="@style/LauncherMenuButton.Universal"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="3dp"
                        android:drawableStart="@drawable/ic_px_store"
                        app:drawableTint="@color/zyrox_amber"
                        android:text="@string/zyrox_nav_modpacks" />

                    <com.kdt.mcgui.LauncherMenuButton
                        android:id="@+id/instances_button"
                        style="@style/LauncherMenuButton.Universal"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:drawableStart="@drawable/ic_px_instances"
                        app:drawableTint="@color/zyrox_amber"
                        android:text="@string/zyrox_nav_instances" />
                </LinearLayout>

                <!-- Row 2: INSTALL JAR | CONTROLS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <com.kdt.mcgui.LauncherMenuButton
                        android:id="@+id/install_jar_button"
                        style="@style/LauncherMenuButton.Universal"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="3dp"
                        android:drawableStart="@drawable/ic_px_java_run"
                        app:drawableTint="@color/zyrox_amber"
                        android:text="@string/zyrox_nav_install_jar" />

                    <com.kdt.mcgui.LauncherMenuButton
                        android:id="@+id/custom_control_button"
                        style="@style/LauncherMenuButton.Universal"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:drawableStart="@drawable/ic_px_gamepad"
                        app:drawableTint="@color/zyrox_amber"
                        android:text="@string/zyrox_nav_controls" />
                </LinearLayout>

                <!-- Row 3: SETTINGS | LOGS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <com.kdt.mcgui.LauncherMenuButton
                        android:id="@+id/home_settings_button"
                        style="@style/LauncherMenuButton.Universal"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="3dp"
                        android:drawableStart="@drawable/ic_px_sliders"
                        app:drawableTint="@color/zyrox_amber"
                        android:text="@string/zyrox_nav_settings" />

                    <com.kdt.mcgui.LauncherMenuButton
                        android:id="@+id/share_logs_button"
                        style="@style/LauncherMenuButton.Universal"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:drawableStart="@drawable/ic_px_console"
                        app:drawableTint="@color/zyrox_amber"
                        android:text="@string/zyrox_nav_logs" />
                </LinearLayout>

                <!-- Translucent Crystal Utility Capsule: FILES · WIKI · DISCORD -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="27dp"
                    android:layout_marginTop="7dp"
                    android:paddingHorizontal="2dp"
                    android:background="@drawable/bg_zyrox_footer_pill"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/open_files_button"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_zyrox_nav_item"
                        android:text="@string/zyrox_nav_files"
                        android:textColor="@color/zyrox_text_subtle"
                        android:textSize="8.5sp"
                        android:letterSpacing="0.06"
                        android:shadowColor="#B3090705"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="3"
                        android:stateListAnimator="@null"
                        android:fontFamily="@font/minecraft_pixel"
                        app:fontFamily="@font/minecraft_pixel" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="11dp"
                        android:background="@color/zyrox_divider" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/news_button"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_zyrox_nav_item"
                        android:text="@string/mcl_tab_wiki"
                        android:textColor="@color/zyrox_text_subtle"
                        android:textSize="8.5sp"
                        android:letterSpacing="0.06"
                        android:shadowColor="#B3090705"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="3"
                        android:stateListAnimator="@null"
                        android:fontFamily="@font/minecraft_pixel"
                        app:fontFamily="@font/minecraft_pixel" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="11dp"
                        android:background="@color/zyrox_divider" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/social_media_button"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_zyrox_nav_item"
                        android:text="@string/mcl_button_social_media"
                        android:textColor="@color/zyrox_text_subtle"
                        android:textSize="8.5sp"
                        android:letterSpacing="0.05"
                        android:shadowColor="#B3090705"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="3"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:stateListAnimator="@null"
                        android:fontFamily="@font/minecraft_pixel"
                        app:fontFamily="@font/minecraft_pixel" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- Subtle Luminous Footer Engine Watermark -->
        <TextView
            android:id="@+id/tv_zyrox_watermark"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/zyrox_engine_watermark"
            android:textColor="@color/zyrox_text_muted"
            android:textSize="8sp"
            android:letterSpacing="0.14"
            android:shadowColor="#B3090705"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:fontFamily="@font/minecraft_pixel"
            app:fontFamily="@font/minecraft_pixel"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 2. CENTER HERO BRAND ZONE (floating cleanly across full-screen open shader sky) -->
    <LinearLayout
        android:id="@+id/zyrox_hero_brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/zyrox_left_dock">

        <TextView
            android:id="@+id/tv_zyrox_hero_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/zyrox_brand_title"
            android:textColor="@color/zyrox_text_primary"
            android:textSize="46sp"
            android:letterSpacing="0.12"
            android:includeFontPadding="false"
            android:shadowColor="#D9EA580C"
            android:shadowDx="0"
            android:shadowDy="3"
            android:shadowRadius="20"
            android:fontFamily="@font/minecraft_pixel"
            app:fontFamily="@font/minecraft_pixel" />

        <TextView
            android:id="@+id/tv_zyrox_hero_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/zyrox_brand_subtitle"
            android:textColor="@color/zyrox_amber_stroke"
            android:textSize="13sp"
            android:letterSpacing="0.38"
            android:shadowColor="#CC090705"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="8"
            android:fontFamily="@font/minecraft_pixel"
            app:fontFamily="@font/minecraft_pixel" />

        <View
            android:layout_width="136dp"
            android:layout_height="1.5dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_zyrox_hero_divider" />
    </LinearLayout>

    <!-- 3. BOTTOM-LEFT ULTRA-TRANSPARENT FLOATING CRYSTAL UPDATES CARD -->
    <LinearLayout
        android:id="@+id/zyrox_updates_card"
        android:layout_width="246dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginBottom="14dp"
        android:orientation="vertical"
        android:background="@drawable/bg_zyrox_glass_card_soft"
        android:paddingHorizontal="13dp"
        android:paddingVertical="11dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/bg_zyrox_dot_amber" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:text="@string/zyrox_updates_title"
                android:textColor="@color/zyrox_text_primary"
                android:textSize="10.5sp"
                android:letterSpacing="0.08"
                android:shadowColor="#BF090705"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:fontFamily="@font/minecraft_pixel"
                app:fontFamily="@font/minecraft_pixel" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="7dp"
                android:paddingVertical="1.5dp"
                android:background="@drawable/bg_zyrox_badge"
                android:text="@string/zyrox_updates_badge"
                android:textColor="@color/zyrox_amber_stroke"
                android:textSize="8.5sp"
                android:fontFamily="@font/minecraft_pixel"
                app:fontFamily="@font/minecraft_pixel" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="7dp"
            android:background="@drawable/bg_zyrox_hero_divider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/zyrox_updates_line1"
            android:textColor="@color/zyrox_text_secondary"
            android:textSize="10.5sp"
            android:shadowColor="#CC090705"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:lineSpacingExtra="1dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2.5dp"
            android:text="@string/zyrox_updates_line2"
            android:textColor="@color/zyrox_text_secondary"
            android:textSize="10.5sp"
            android:shadowColor="#CC090705"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2.5dp"
            android:text="@string/zyrox_updates_line3"
            android:textColor="@color/zyrox_text_secondary"
            android:textSize="10.5sp"
            android:shadowColor="#CC090705"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4" />

        <TextView
            android:id="@+id/tv_zyrox_engine_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:textColor="@color/zyrox_amber_stroke"
            android:textSize="9sp"
            android:letterSpacing="0.06"
            android:shadowColor="#CC090705"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:singleLine="true"
            android:ellipsize="end"
            android:fontFamily="@font/minecraft_pixel"
            app:fontFamily="@font/minecraft_pixel"
            tools:text="RAM 2048 MB  •  ZINK VULKAN" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
