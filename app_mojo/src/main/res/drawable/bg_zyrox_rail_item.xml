<?xml version="1.0" encoding="utf-8"?>
<!-- Zyrox Sakura Crystal Settings & Instance Rail Item -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#4AFFE4F2" android:endColor="#30F4A4CC" />
            <stroke android:width="1.15dp" android:color="#F6FFF7FB" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#42FFE0F0" android:endColor="#28F29AC5" />
                    <stroke android:width="1.15dp" android:color="#F0FFF5FA" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item android:left="10dp" android:top="2.4dp" android:right="10dp" android:height="1.2dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#00FFFFFF" android:centerColor="#A4FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#42FFE0F0" android:endColor="#28F29AC5" />
            <stroke android:width="1.15dp" android:color="#F0FFF5FA" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#18FFF2F8" android:endColor="#0EFAD4E8" />
            <stroke android:width="0.85dp" android:color="#48FCE8F3" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
