<?xml version="1.0" encoding="utf-8"?>
<!-- Zyrox Starlight Blossom Liquid Glass Task & Download Progress Bar -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#28F2F8FF"
                android:endColor="#18CCDDF4" />
            <stroke android:width="1dp" android:color="#92EBF3FE" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip android:clipOrientation="horizontal" android:gravity="left">
            <shape android:shape="rectangle">
                <gradient
                    android:angle="0"
                    android:startColor="#5C84B1F0"
                    android:centerColor="#7AB2CEF7"
                    android:endColor="#98E5F0FE"
                    android:type="linear" />
                <corners android:radius="999dp" />
            </shape>
        </clip>
    </item>
</layer-list>
