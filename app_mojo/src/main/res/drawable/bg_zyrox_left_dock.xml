<?xml version="1.0" encoding="utf-8"?>
<!-- Zyrox Starlight Celestial Frosted Liquid Glass Left Studio Rail -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#460B1120"
                android:endColor="#320A101E" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#16F0F7FF"
                android:centerColor="#00FFFFFF"
                android:endColor="#14080D18" />
        </shape>
    </item>
    <item android:width="1.1dp" android:gravity="end">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#30F0F7FF"
                android:centerColor="#9AE5F0FE"
                android:endColor="#30F0F7FF" />
        </shape>
    </item>
</layer-list>
