<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#3B0C0906"
                android:endColor="#240E0A07" />
        </shape>
    </item>
    <item
        android:width="1dp"
        android:gravity="end|fill_vertical">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#2EFFC482"
                android:centerColor="#66FFB870"
                android:endColor="#2EFFC482" />
        </shape>
    </item>
</layer-list>
