<?xml version="1.0" encoding="utf-8"?>
<!-- Zyrox Ultra-Clear Liquid Glass Switch Track -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <size android:width="44dp" android:height="24dp" />
            <gradient android:angle="270" android:startColor="#50D6EEFF" android:endColor="#38B2DCFF" />
            <stroke android:width="1.1dp" android:color="#EEFFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <size android:width="44dp" android:height="24dp" />
            <gradient android:angle="270" android:startColor="#1CF2F8FF" android:endColor="#12D8E8F8" />
            <stroke android:width="1dp" android:color="#74ECF4FC" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
