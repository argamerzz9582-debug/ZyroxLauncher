<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <size android:width="42dp" android:height="22dp" />
            <gradient
                android:angle="0"
                android:startColor="#EA580C"
                android:endColor="#FF8C42"
                android:type="linear" />
            <stroke android:width="1dp" android:color="#FDBA74" />
            <corners android:radius="11dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <size android:width="42dp" android:height="22dp" />
            <solid android:color="#CC261E1A" />
            <stroke android:width="1dp" android:color="#4078716C" />
            <corners android:radius="11dp" />
        </shape>
    </item>
</selector>
