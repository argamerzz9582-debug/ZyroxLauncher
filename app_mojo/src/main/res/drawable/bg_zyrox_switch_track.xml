<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <size android:width="42dp" android:height="22dp" />
            <gradient
                android:angle="270"
                android:startColor="#B4C3D4E6"
                android:endColor="#A6A8BCD2"
                android:type="linear" />
            <stroke android:width="1.3dp" android:color="#F6FFFFFF" />
            <corners android:radius="11dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <size android:width="42dp" android:height="22dp" />
            <solid android:color="#628E98A6" />
            <stroke android:width="1.1dp" android:color="#9CFFFFFF" />
            <corners android:radius="11dp" />
        </shape>
    </item>
</selector>
