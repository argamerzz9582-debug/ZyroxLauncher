<?xml version="1.0" encoding="utf-8"?>
<!-- Zyrox Starlight Blossom Liquid Glass Switch Track -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <size android:width="44dp" android:height="24dp" />
            <gradient android:angle="270" android:startColor="#62BBD5F9" android:endColor="#4884B1EF" />
            <stroke android:width="1.15dp" android:color="#F4F5F9FF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <size android:width="44dp" android:height="24dp" />
            <gradient android:angle="270" android:startColor="#22F2F8FF" android:endColor="#14CED8E7" />
            <stroke android:width="1dp" android:color="#7CE8F1FB" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
