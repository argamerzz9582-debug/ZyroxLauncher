<?xml version="1.0" encoding="utf-8"?>
<!-- Zyrox Sakura Blossom Liquid Glass Switch Track -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <size android:width="44dp" android:height="24dp" />
            <gradient android:angle="270" android:startColor="#62F9C4E0" android:endColor="#48EF8CBA" />
            <stroke android:width="1.15dp" android:color="#F4FFF5FA" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <size android:width="44dp" android:height="24dp" />
            <gradient android:angle="270" android:startColor="#22FFF2F8" android:endColor="#14EAD4E2" />
            <stroke android:width="1dp" android:color="#7CFCE8F3" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
