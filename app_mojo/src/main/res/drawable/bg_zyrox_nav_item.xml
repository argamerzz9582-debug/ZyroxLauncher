<?xml version="1.0" encoding="utf-8"?>
<!-- Zyrox Ultra-Clear Liquid Glass Nav & In-Game Drawer Pill Row -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#44E4F3FF" android:endColor="#2AC4E2FF" />
                    <stroke android:width="1.15dp" android:color="#F4FFFFFF" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item android:left="12dp" android:top="2.4dp" android:right="12dp" android:height="1.3dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#00FFFFFF" android:centerColor="#B8FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#38E0F1FF" android:endColor="#20BEE0FF" />
                    <stroke android:width="1.1dp" android:color="#EAFFFFFF" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item android:left="12dp" android:top="2.4dp" android:right="12dp" android:height="1.2dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#00FFFFFF" android:centerColor="#9AFFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#38E0F1FF" android:endColor="#20BEE0FF" />
            <stroke android:width="1.1dp" android:color="#EAFFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#18F6FBFF" android:endColor="#0CDCEBF8" />
            <stroke android:width="0.9dp" android:color="#5CF2F8FF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
