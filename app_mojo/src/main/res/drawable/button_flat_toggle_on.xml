<?xml version="1.0" encoding="utf-8"?>
<!-- Zyrox 2.0 Toggle Button ON — Cool Ice-Blue Liquid Glass -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#66C9D7E4" android:endColor="#72ADB9CA" />
            <corners android:radius="11dp" />
        </shape>
    </item>
    <item android:left="1.2dp" android:top="1.2dp" android:right="1.2dp" android:bottom="1.2dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#A2B4C2D2" android:endColor="#9AA4B3C5" />
            <stroke android:width="1.4dp" android:color="#F6FFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:left="8dp" android:top="3.8dp" android:right="8dp" android:height="2dp" android:gravity="top">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#1AFFFFFF" android:centerColor="#92FFFFFF" android:endColor="#1AFFFFFF" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
