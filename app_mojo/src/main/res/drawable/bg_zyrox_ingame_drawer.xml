<?xml version="1.0" encoding="utf-8"?>
<!-- Zyrox Sakura Smoked-Crystal Floating In-Game Menu Drawer -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#28110818" />
            <stroke android:width="1dp" android:color="#40120919" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#9C1B1026"
                android:centerColor="#8E150C1E"
                android:endColor="#98180E23" />
            <stroke android:width="1.2dp" android:color="#C2FFEAF5" />
            <corners android:radius="19dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:height="22dp" android:gravity="top">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#24FFF2F8" android:endColor="#00FFFFFF" />
            <corners android:topLeftRadius="17dp" android:topRightRadius="17dp" />
        </shape>
    </item>
</layer-list>
