<?xml version="1.0" encoding="utf-8"?>
<!-- Zyrox Ultra-Sheer Liquid Glass Right Home Dock (Zero Amber, Maximum Live Scene Visibility) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Feather-light smoked-crystal atmospheric veil so the live shader shines right through -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#16080D16"
                android:centerColor="#22090F19"
                android:endColor="#30090E18" />
        </shape>
    </item>
    <!-- Delicate curved liquid skylight refraction -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#14F6FBFF"
                android:centerColor="#04FFFFFF"
                android:endColor="#14070B13" />
        </shape>
    </item>
    <!-- Razor-sharp 1dp diamond-crystal left specular hairline -->
    <item
        android:width="1dp"
        android:gravity="start|fill_vertical">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#28FFFFFF"
                android:centerColor="#8CF4FAFF"
                android:endColor="#28E0F0FF" />
        </shape>
    </item>
</layer-list>
