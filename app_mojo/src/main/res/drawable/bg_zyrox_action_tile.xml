<?xml version="1.0" encoding="utf-8"?>
<!-- Zyrox 2.0 Action Tile & Icon Squircle Button — Exact Neutral Frosted Liquid Glass -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pressed: Cool Ice-Blue Liquid Glass -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#66C9D7E4" android:endColor="#74ADB9CA" />
                    <stroke android:width="1.2dp" android:color="#8AD2E2F2" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item android:left="1.4dp" android:top="1.4dp" android:right="1.4dp" android:bottom="1.4dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#9CB0BCCB"
                        android:centerColor="#96A9B6C6"
                        android:endColor="#9AA6B3C4" />
                    <stroke android:width="1.5dp" android:color="#F6FFFFFF" />
                    <corners android:radius="10.5dp" />
                </shape>
            </item>
            <item android:left="3.8dp" android:top="3.8dp" android:right="3.8dp" android:bottom="3.8dp">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="0.9dp" android:color="#80F5F9FF" />
                    <corners android:radius="8.5dp" />
                </shape>
            </item>
            <item android:left="9dp" android:top="4.8dp" android:right="9dp" android:height="2dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#1CFFFFFF" android:centerColor="#94FFFFFF" android:endColor="#1CFFFFFF" />
                    <corners android:radius="2dp" />
                </shape>
            </item>
            <item android:left="14dp" android:bottom="4.8dp" android:right="14dp" android:height="1.6dp" android:gravity="bottom">
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#10FFFFFF" android:centerColor="#58FFFFFF" android:endColor="#10FFFFFF" />
                    <corners android:radius="2dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Focused -->
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#4ED2E2F4" />
                    <stroke android:width="2dp" android:color="#FFFFFFFF" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#92B1B8C2" android:endColor="#8EA4ACB7" />
                    <stroke android:width="1.3dp" android:color="#F2FFFFFF" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Default: Neutral Frosted Liquid Glass Squircle -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#3CE6EDF3" android:endColor="#48B1BAC5" />
                    <stroke android:width="1dp" android:color="#64E4EBF2" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item android:left="1.4dp" android:top="1.4dp" android:right="1.4dp" android:bottom="1.4dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#88B1B8C2"
                        android:centerColor="#82AAB1BB"
                        android:endColor="#86A4ACB7" />
                    <stroke android:width="1.4dp" android:color="#EEFFFFFF" />
                    <corners android:radius="10.5dp" />
                </shape>
            </item>
            <item android:left="3.8dp" android:top="3.8dp" android:right="3.8dp" android:bottom="3.8dp">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="0.9dp" android:color="#68F4F7FA" />
                    <corners android:radius="8.5dp" />
                </shape>
            </item>
            <item android:left="9dp" android:top="4.8dp" android:right="9dp" android:height="2dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#18FFFFFF" android:centerColor="#80FFFFFF" android:endColor="#18FFFFFF" />
                    <corners android:radius="2dp" />
                </shape>
            </item>
            <item android:left="14dp" android:bottom="4.8dp" android:right="14dp" android:height="1.6dp" android:gravity="bottom">
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#10FFFFFF" android:centerColor="#46FFFFFF" android:endColor="#10FFFFFF" />
                    <corners android:radius="2dp" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>
