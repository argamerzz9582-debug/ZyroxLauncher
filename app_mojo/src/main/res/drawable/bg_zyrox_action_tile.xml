<?xml version="1.0" encoding="utf-8"?>
<!-- Zyrox Ultra-Clear Liquid Glass Action Tile & Squircle Button (~90–95% Transparent Crystal) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#46E4F3FF"
                        android:centerColor="#26C4E2FF"
                        android:endColor="#38D4ECFF" />
                    <stroke android:width="1.25dp" android:color="#F4FFFFFF" />
                    <corners android:radius="12.5dp" />
                </shape>
            </item>
            <item android:left="9dp" android:top="3dp" android:right="9dp" android:height="1.5dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#00FFFFFF" android:centerColor="#C0FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#30F0F8FF" android:endColor="#20D4EAFF" />
            <stroke android:width="1.6dp" android:color="#FFFFFFFF" />
            <corners android:radius="12.5dp" />
        </shape>
    </item>

    <!-- Default: Ultra-Sheer Liquid Glass Tile (Background Shines Vividly Right Through) -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="0.85dp" android:color="#26060B14" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
            <item android:left="0.8dp" android:top="0.8dp" android:right="0.8dp" android:bottom="0.8dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#22F8FCFF"
                        android:centerColor="#0CEAF4FF"
                        android:endColor="#18DCEBF8" />
                    <stroke android:width="1.1dp" android:color="#BCFFFFFF" />
                    <corners android:radius="12.2dp" />
                </shape>
            </item>
            <item android:left="2.8dp" android:top="2.8dp" android:right="2.8dp" android:bottom="2.8dp">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="0.65dp" android:color="#34F4FAFF" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:left="9dp" android:top="2.8dp" android:right="9dp" android:height="1.3dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#00FFFFFF" android:centerColor="#8AFFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
            <item android:left="16dp" android:bottom="2.8dp" android:right="16dp" android:height="1.1dp" android:gravity="bottom">
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#00E4F6FF" android:centerColor="#46E8F8FF" android:endColor="#00E4F6FF" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>
