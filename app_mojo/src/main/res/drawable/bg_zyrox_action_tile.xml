<?xml version="1.0" encoding="utf-8"?>
<!-- Ultra-transparent crystal-glass action tile for Home Hub Right Control Panel -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#57FF9C42"
                android:endColor="#36EA580C" />
            <stroke
                android:width="1.25dp"
                android:color="#E0FFD29E" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#3D26180F" />
            <stroke
                android:width="1.25dp"
                android:color="#C7FFC482" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#261A130E"
                        android:endColor="#1C0E0A07" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#12FFF9F2"
                        android:centerColor="#00FFFFFF"
                        android:endColor="#00FFFFFF" />
                    <stroke
                        android:width="1dp"
                        android:color="#38FFC07A" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
