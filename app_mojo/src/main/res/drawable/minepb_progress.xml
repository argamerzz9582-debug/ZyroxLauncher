<?xml version="1.0" encoding="utf-8"?>
<!-- Zyrox Sakura Blossom Liquid Glass SeekBar & Progress Track -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#22FCE8F3" />
            <stroke android:width="0.9dp" android:color="#6CFCE8F3" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <clip android:clipOrientation="horizontal" android:gravity="left">
            <shape android:shape="rectangle">
                <solid android:color="#52F7BAD8" />
                <corners android:radius="999dp" />
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress">
        <clip android:clipOrientation="horizontal" android:gravity="left">
            <shape android:shape="rectangle">
                <gradient
                    android:angle="0"
                    android:startColor="#D8F296C2"
                    android:centerColor="#EEF9C6E1"
                    android:endColor="#FFFFF7FB"
                    android:type="linear" />
                <corners android:radius="999dp" />
            </shape>
        </clip>
    </item>
</layer-list>
