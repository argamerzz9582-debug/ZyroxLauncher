<?xml version="1.0" encoding="utf-8"?>
<!-- Zyrox Sakura Floating Capsule Pill (HUD Editor Toolbar & Quick Overlays) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#6C1A1025" android:endColor="#58140B1D" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#22FFF2F8" android:centerColor="#08FCE6F2" android:endColor="#16FAD4E8" />
            <stroke android:width="1.1dp" android:color="#B8FFEAF5" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</layer-list>
