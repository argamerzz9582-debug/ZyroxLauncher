<?xml version="1.0" encoding="utf-8"?>
<!-- Zyrox Starlight Pearl Liquid Glass Secondary Button -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#14D4DCE7" />
            <stroke android:width="1dp" android:color="#42F2F8FF" />
            <corners android:radius="13dp" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#50E5F0FE"
                        android:centerColor="#329ABFF4"
                        android:endColor="#44B9D4F9" />
                    <stroke android:width="1.3dp" android:color="#FAF7FAFF" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
            <item android:left="11dp" android:top="3.2dp" android:right="11dp" android:height="1.6dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#00FFFFFF" android:centerColor="#CCFFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#46E3EFFE"
                        android:centerColor="#2A94BCF3"
                        android:endColor="#3CB3D0F8" />
                    <stroke android:width="1.25dp" android:color="#F2F5F9FF" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
            <item android:left="11dp" android:top="3.2dp" android:right="11dp" android:height="1.5dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#00FFFFFF" android:centerColor="#B8FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#3AEBF4FE" android:endColor="#28BBD5F8" />
            <stroke android:width="1.6dp" android:color="#FFFAFCFF" />
            <corners android:radius="13dp" />
        </shape>
    </item>

    <!-- Default: Ultra-Sheer Starlight Pearl Crystal Glass -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="0.9dp" android:color="#30070D19" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
            <item android:left="0.8dp" android:top="0.8dp" android:right="0.8dp" android:bottom="0.8dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#2CF5F9FF"
                        android:centerColor="#16E5EEFB"
                        android:endColor="#22C9DCF8" />
                    <stroke android:width="1.1dp" android:color="#C8F2F8FF" />
                    <corners android:radius="12.2dp" />
                </shape>
            </item>
            <item android:left="2.8dp" android:top="2.8dp" android:right="2.8dp" android:bottom="2.8dp">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="0.65dp" android:color="#38FFFFFF" />
                    <corners android:radius="10.4dp" />
                </shape>
            </item>
            <item android:left="12dp" android:top="3.2dp" android:right="12dp" android:height="1.4dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#00FFFFFF" android:centerColor="#92FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>
