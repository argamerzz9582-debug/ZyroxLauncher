<?xml version="1.0" encoding="utf-8"?>
<!-- Zyrox Ultra-Clear Liquid Glass Secondary Button -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#12D8E2EE" />
            <stroke android:width="1dp" android:color="#3EFFFFFF" />
            <corners android:radius="13dp" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#48E4F3FF"
                        android:centerColor="#28C4E2FF"
                        android:endColor="#3CD4ECFF" />
                    <stroke android:width="1.3dp" android:color="#F4FFFFFF" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
            <item android:left="11dp" android:top="3.2dp" android:right="11dp" android:height="1.6dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#00FFFFFF" android:centerColor="#C4FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#3EE0F1FF"
                        android:centerColor="#22BEE0FF"
                        android:endColor="#34CEEAFF" />
                    <stroke android:width="1.25dp" android:color="#EEFFFFFF" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
            <item android:left="11dp" android:top="3.2dp" android:right="11dp" android:height="1.5dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#00FFFFFF" android:centerColor="#B0FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#32F0F8FF" android:endColor="#22D4EAFF" />
            <stroke android:width="1.6dp" android:color="#FFFFFFFF" />
            <corners android:radius="13dp" />
        </shape>
    </item>

    <!-- Default: Ultra-Sheer Water-Droplet Crystal Glass -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="0.9dp" android:color="#28060B14" />
                    <corners android:radius="13.5dp" />
                </shape>
            </item>
            <item android:left="0.8dp" android:top="0.8dp" android:right="0.8dp" android:bottom="0.8dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#24F8FCFF"
                        android:centerColor="#0EEAF4FF"
                        android:endColor="#1CDCEBF8" />
                    <stroke android:width="1.15dp" android:color="#C8FFFFFF" />
                    <corners android:radius="12.7dp" />
                </shape>
            </item>
            <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="0.7dp" android:color="#38F4FAFF" />
                    <corners android:radius="10.5dp" />
                </shape>
            </item>
            <item android:left="11dp" android:top="3dp" android:right="11dp" android:height="1.4dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#00FFFFFF" android:centerColor="#92FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
            <item android:left="20dp" android:bottom="3dp" android:right="20dp" android:height="1.2dp" android:gravity="bottom">
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#00E4F6FF" android:centerColor="#4CE8F8FF" android:endColor="#00E4F6FF" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>
