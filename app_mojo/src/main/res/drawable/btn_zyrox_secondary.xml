<?xml version="1.0" encoding="utf-8"?>
<!-- Zyrox Sakura Pearl Liquid Glass Secondary Button -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#14EADAE4" />
            <stroke android:width="1dp" android:color="#42FFF2F8" />
            <corners android:radius="13dp" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#50FFE4F2"
                        android:centerColor="#32F4A2CA"
                        android:endColor="#44F9C2DE" />
                    <stroke android:width="1.3dp" android:color="#FAFFF7FB" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
            <item android:left="11dp" android:top="3.2dp" android:right="11dp" android:height="1.6dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#00FFFFFF" android:centerColor="#CCFFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#46FFE2F1"
                        android:centerColor="#2AF39CC6"
                        android:endColor="#3CF8BCDA" />
                    <stroke android:width="1.25dp" android:color="#F2FFF5FA" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
            <item android:left="11dp" android:top="3.2dp" android:right="11dp" android:height="1.5dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#00FFFFFF" android:centerColor="#B8FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#3AFFEBF5" android:endColor="#28F8C4DF" />
            <stroke android:width="1.6dp" android:color="#FFFFFAFD" />
            <corners android:radius="13dp" />
        </shape>
    </item>

    <!-- Default: Ultra-Sheer Sakura Pearl Crystal Glass -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="0.9dp" android:color="#30120919" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
            <item android:left="0.8dp" android:top="0.8dp" android:right="0.8dp" android:bottom="0.8dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#2CFFF5FA"
                        android:centerColor="#16FCE4F1"
                        android:endColor="#22F9D2E7" />
                    <stroke android:width="1.1dp" android:color="#C8FFF2F8" />
                    <corners android:radius="12.2dp" />
                </shape>
            </item>
            <item android:left="2.8dp" android:top="2.8dp" android:right="2.8dp" android:bottom="2.8dp">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="0.65dp" android:color="#38FFFFFF" />
                    <corners android:radius="10.4dp" />
                </shape>
            </item>
            <item android:left="12dp" android:top="3.2dp" android:right="12dp" android:height="1.4dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#00FFFFFF" android:centerColor="#92FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>
