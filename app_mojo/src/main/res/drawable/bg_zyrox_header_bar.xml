<?xml version="1.0" encoding="utf-8"?>
<!-- Zyrox Starlight Twilight Smoked-Crystal Global Sub-Page Header Bar -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#640B1120"
                android:endColor="#420A101E" />
        </shape>
    </item>
    <item android:height="14dp" android:gravity="top">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#1CF2F8FF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item android:height="1.1dp" android:gravity="bottom">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#28E7F0FB"
                android:centerColor="#A4E5F0FE"
                android:endColor="#28E7F0FB" />
        </shape>
    </item>
</layer-list>
