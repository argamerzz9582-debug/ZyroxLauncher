<?xml version="1.0" encoding="utf-8"?>
<!-- Zyrox Starlight Smoked-Crystal Glass Card -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#6C0E1525"
                android:endColor="#5A090F1D" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#1EF2F8FF"
                android:centerColor="#06FFFFFF"
                android:endColor="#12D5E5F9" />
            <stroke android:width="1.1dp" android:color="#A2E9F2FE" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:left="18dp" android:top="2.2dp" android:right="18dp" android:height="1.2dp" android:gravity="top">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#00FFFFFF" android:centerColor="#7CF5F9FF" android:endColor="#00FFFFFF" />
            <corners android:radius="1dp" />
        </shape>
    </item>
</layer-list>
