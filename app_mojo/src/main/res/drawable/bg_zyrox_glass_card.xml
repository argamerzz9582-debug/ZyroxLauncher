<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#4818120E"
                android:endColor="#380E0B08" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#12FFF9F2"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="@color/zyrox_glass_border" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
