<?xml version="1.0" encoding="utf-8"?>
<!-- Zyrox Ultra-Clear Emerald-Crystal Liquid Glass Installed/Active Button -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#4886EFAC" android:endColor="#2C34D399" />
            <stroke android:width="1.25dp" android:color="#F4ECFDF5" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#2C86EFAC" android:centerColor="#1634D399" android:endColor="#246EE7B7" />
                    <stroke android:width="1.1dp" android:color="#CCDCFCE7" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
            <item android:left="11dp" android:top="2.8dp" android:right="11dp" android:height="1.3dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#00FFFFFF" android:centerColor="#92FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
