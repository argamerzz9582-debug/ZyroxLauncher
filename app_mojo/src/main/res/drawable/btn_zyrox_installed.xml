<?xml version="1.0" encoding="utf-8"?>
<!-- Zyrox 2.0 Installed / Verified State Button — Frosted Mint-Ice Liquid Glass -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#5CBADEC9" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
            <item android:left="1.5dp" android:top="1.5dp" android:right="1.5dp" android:bottom="1.5dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#9C9AC4AD" android:endColor="#948AB69E" />
                    <stroke android:width="1.5dp" android:color="#F4F2FFF8" />
                    <corners android:radius="11.5dp" />
                </shape>
            </item>
            <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="0.9dp" android:color="#78F2FFF8" />
                    <corners android:radius="9dp" />
                </shape>
            </item>
            <item android:left="11dp" android:top="5dp" android:right="11dp" android:height="2dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#18FFFFFF" android:centerColor="#88FFFFFF" android:endColor="#18FFFFFF" />
                    <corners android:radius="2dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#3EC2E2CF" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
            <item android:left="1.5dp" android:top="1.5dp" android:right="1.5dp" android:bottom="1.5dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#8E9EC2AE" android:endColor="#868EB4A0" />
                    <stroke android:width="1.4dp" android:color="#EEF4FFF9" />
                    <corners android:radius="11.5dp" />
                </shape>
            </item>
            <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="0.9dp" android:color="#6AF2FFF8" />
                    <corners android:radius="9dp" />
                </shape>
            </item>
            <item android:left="11dp" android:top="5dp" android:right="11dp" android:height="2dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#16FFFFFF" android:centerColor="#7EFFFFFF" android:endColor="#16FFFFFF" />
                    <corners android:radius="2dp" />
                </shape>
            </item>
            <item android:left="20dp" android:bottom="5dp" android:right="20dp" android:height="1.6dp" android:gravity="bottom">
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#10FFFFFF" android:centerColor="#44FFFFFF" android:endColor="#10FFFFFF" />
                    <corners android:radius="2dp" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>
