<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ultra-light crystal optical vignette: leaves the sunlit cherry-blossom scene pure & vivid -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.44"
                android:centerY="0.50"
                android:gradientRadius="82%p"
                android:startColor="#00070B14"
                android:centerColor="#06070B14"
                android:endColor="#2E070B14" />
        </shape>
    </item>
    <!-- Soft right-edge optical scrim so white Liquid Glass dock controls stay crisp over sunlit sky -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#00070B14"
                android:centerColor="#06070B14"
                android:endColor="#36080C16" />
        </shape>
    </item>
</layer-list>
