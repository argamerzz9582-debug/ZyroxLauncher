<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Whisper-light optical radial edge vignette so the full-screen live scene stays vivid -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.46"
                android:centerY="0.48"
                android:gradientRadius="76%p"
                android:startColor="#00070B14"
                android:centerColor="#12070B14"
                android:endColor="#4E070B14" />
        </shape>
    </item>
    <!-- Delicate bottom ground contrast so floating Liquid Glass labels remain crisp -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#16070B14"
                android:centerColor="#00000000"
                android:endColor="#42070B14" />
        </shape>
    </item>
</layer-list>
