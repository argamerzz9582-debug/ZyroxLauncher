<?xml version="1.0" encoding="utf-8"?>
<!-- Zyrox Starlight Rose-Pearl SeekBar Thumb -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <size android:width="20dp" android:height="20dp" />
            <gradient android:angle="270" android:startColor="#FFFAFCFF" android:endColor="#FFB3CFF7" />
            <stroke android:width="1.5dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <size android:width="18dp" android:height="18dp" />
            <gradient android:angle="270" android:startColor="#FFFAFCFF" android:endColor="#FFD9E7F9" />
            <stroke android:width="1.1dp" android:color="#FFA0C3F5" />
        </shape>
    </item>
</selector>
