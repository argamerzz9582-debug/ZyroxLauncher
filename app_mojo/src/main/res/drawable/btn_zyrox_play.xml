<?xml version="1.0" encoding="utf-8"?>
<!-- Zyrox Ultra-Clear Liquid Glass Primary CTA Button (Maximum Transparency + Luminous Diamond Refraction) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Disabled -->
    <item android:state_enabled="false">
        <layer-list>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#16DCE6F2" />
                    <stroke android:width="1dp" android:color="#48FFFFFF" />
                    <corners android:radius="15dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Pressed: Luminous Liquid-Ice Refraction Bloom -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#28CCE8FF" />
                    <stroke android:width="1dp" android:color="#74D8EEFF" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item android:left="1.2dp" android:top="1.2dp" android:right="1.2dp" android:bottom="1.2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#54E8F5FF"
                        android:centerColor="#30C6E4FF"
                        android:endColor="#46D6EEFF" />
                    <stroke android:width="1.45dp" android:color="#FAFFFFFF" />
                    <corners android:radius="14.8dp" />
                </shape>
            </item>
            <item android:left="3.5dp" android:top="3.5dp" android:right="3.5dp" android:bottom="3.5dp">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="0.85dp" android:color="#6CF6FBFF" />
                    <corners android:radius="12.5dp" />
                </shape>
            </item>
            <item android:left="14dp" android:top="4dp" android:right="14dp" android:height="2dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#00FFFFFF" android:centerColor="#D8FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="1.5dp" />
                </shape>
            </item>
            <item android:left="26dp" android:bottom="4dp" android:right="26dp" android:height="1.5dp" android:gravity="bottom">
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#00E4F6FF" android:centerColor="#82E8F8FF" android:endColor="#00E4F6FF" />
                    <corners android:radius="1.5dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Focused -->
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#24D4EAFF" />
                    <stroke android:width="1.8dp" android:color="#FFFFFFFF" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item android:left="1.6dp" android:top="1.6dp" android:right="1.6dp" android:bottom="1.6dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#3CF4FAFF" android:centerColor="#20E2F0FF" android:endColor="#32D4EAFF" />
                    <stroke android:width="1.3dp" android:color="#F0FFFFFF" />
                    <corners android:radius="14.4dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Default: Sculpted Crystal-Clear Hero Liquid Glass -->
    <item>
        <layer-list>
            <!-- 1. Hairline outer optical depth contour -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="1dp" android:color="#2E060B14" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <!-- 2. Ultra-sheer crystal lens body + luminous diamond rim -->
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#36FAFDFF"
                        android:centerColor="#16E8F3FF"
                        android:endColor="#2AD6ECFF" />
                    <stroke android:width="1.35dp" android:color="#E8FFFFFF" />
                    <corners android:radius="15dp" />
                </shape>
            </item>
            <!-- 3. Upper curved convex dome highlight -->
            <item android:left="2.2dp" android:top="2.2dp" android:right="2.2dp" android:height="16dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#2CFFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:topLeftRadius="13.5dp" android:topRightRadius="13.5dp" />
                </shape>
            </item>
            <!-- 4. Concentric inner refractive meniscus ring -->
            <item android:left="3.5dp" android:top="3.5dp" android:right="3.5dp" android:bottom="3.5dp">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="0.8dp" android:color="#4CF6FBFF" />
                    <corners android:radius="12.5dp" />
                </shape>
            </item>
            <!-- 5. Top specular light filament -->
            <item android:left="14dp" android:top="3.8dp" android:right="14dp" android:height="1.8dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#00FFFFFF" android:centerColor="#B0FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="1.5dp" />
                </shape>
            </item>
            <!-- 6. Bottom underwater caustic reflection -->
            <item android:left="26dp" android:bottom="3.8dp" android:right="26dp" android:height="1.4dp" android:gravity="bottom">
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#00E4F6FF" android:centerColor="#64EAF8FF" android:endColor="#00E4F6FF" />
                    <corners android:radius="1.5dp" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>
