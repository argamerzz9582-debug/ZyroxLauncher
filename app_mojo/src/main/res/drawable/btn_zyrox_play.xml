<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#80292524" />
            <stroke
                android:width="1dp"
                android:color="#4078716C" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FB923C"
                android:endColor="#EA580C"
                android:type="linear" />
            <stroke
                android:width="2dp"
                android:color="#FFF7ED" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FB923C"
                android:endColor="#C2410C"
                android:type="linear" />
            <stroke
                android:width="2dp"
                android:color="#FFF7ED" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#F97316"
                android:endColor="#C2410C"
                android:type="linear" />
            <stroke
                android:width="2dp"
                android:color="#FDBA74" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
