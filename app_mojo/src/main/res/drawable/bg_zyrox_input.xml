<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#4226180F"
                android:endColor="#33170F0A" />
            <stroke
                android:width="1.25dp"
                android:color="#CCFFC482" />
            <corners android:radius="11dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#3B1A120D" />
            <stroke
                android:width="1.25dp"
                android:color="#C7FFB870" />
            <corners android:radius="11dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#2E1B140F"
                        android:endColor="#240E0A08" />
                    <corners android:radius="11dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#16FFF9F2"
                        android:centerColor="#00FFFFFF"
                        android:endColor="#00FFFFFF" />
                    <stroke
                        android:width="1dp"
                        android:color="#47FFC07A" />
                    <corners android:radius="11dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
