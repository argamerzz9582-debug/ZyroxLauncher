<?xml version="1.0" encoding="utf-8"?>
<!-- Zyrox Ultra-Clear Liquid Glass Input, Spinner & List Item Capsule -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#3CE2F2FF"
                android:endColor="#24C2E0FF" />
            <stroke android:width="1.2dp" android:color="#ECFFFFFF" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#30EAF5FF"
                android:endColor="#1CCEE8FF" />
            <stroke android:width="1.3dp" android:color="#F4FFFFFF" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#24101826"
                        android:endColor="#1C0B111C" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#1CF8FCFF"
                        android:centerColor="#08EAF4FF"
                        android:endColor="#12DCEBF8" />
                    <stroke android:width="1dp" android:color="#8AF4FAFF" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
            <item android:left="14dp" android:top="2dp" android:right="14dp" android:height="1.2dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#00FFFFFF" android:centerColor="#68FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
