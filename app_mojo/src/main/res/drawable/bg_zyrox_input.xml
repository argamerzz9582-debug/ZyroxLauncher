<?xml version="1.0" encoding="utf-8"?>
<!-- Zyrox Sakura Pearl Crystal Input, Spinner & Studio Item Surface -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#48FFE4F2" android:endColor="#30F5A8CE" />
            <stroke android:width="1.25dp" android:color="#F4FFF5FA" />
            <corners android:radius="13dp" />
        </shape>
    </item>

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#38FFEBF5" android:endColor="#24F8C4DF" />
            <stroke android:width="1.45dp" android:color="#FAFFF7FB" />
            <corners android:radius="13dp" />
        </shape>
    </item>

    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#2E160D20" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#24FFF4FA"
                        android:centerColor="#0EFCE6F2"
                        android:endColor="#1AFAD2E7" />
                    <stroke android:width="1.05dp" android:color="#B2FFEAF5" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
            <item android:left="12dp" android:top="2.4dp" android:right="12dp" android:height="1.1dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#00FFFFFF" android:centerColor="#76FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>
