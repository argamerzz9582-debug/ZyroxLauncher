<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#D9171210" />
            <stroke
                android:width="1.5dp"
                android:color="@color/zyrox_amber" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#CC1B1512" />
            <stroke
                android:width="1dp"
                android:color="@color/zyrox_glass_border_strong" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/zyrox_glass_input" />
            <stroke
                android:width="1dp"
                android:color="@color/zyrox_glass_border" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
