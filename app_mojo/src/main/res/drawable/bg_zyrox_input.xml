<?xml version="1.0" encoding="utf-8"?>
<!-- Zyrox Starlight Pearl Crystal Input, Spinner & Studio Item Surface -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#48E5F0FE" android:endColor="#30A0C3F5" />
            <stroke android:width="1.25dp" android:color="#F4F5F9FF" />
            <corners android:radius="13dp" />
        </shape>
    </item>

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#38EBF4FE" android:endColor="#24BBD5F8" />
            <stroke android:width="1.45dp" android:color="#FAF7FAFF" />
            <corners android:radius="13dp" />
        </shape>
    </item>

    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#2E0B1120" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#24F4F9FF"
                        android:centerColor="#0EE7F0FB"
                        android:endColor="#1AD3E3F9" />
                    <stroke android:width="1.05dp" android:color="#B2EBF3FE" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
            <item android:left="12dp" android:top="2.4dp" android:right="12dp" android:height="1.1dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#00FFFFFF" android:centerColor="#76FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>
