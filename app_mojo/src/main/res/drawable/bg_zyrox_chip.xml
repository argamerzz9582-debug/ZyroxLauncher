<?xml version="1.0" encoding="utf-8"?>
<!-- Zyrox Ultra-Clear Liquid Glass Capsule Chip -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#48E4F4FF" android:endColor="#32C8E4FF" />
            <stroke android:width="1.2dp" android:color="#F8FFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#3EE2F2FF" android:endColor="#28C2E2FF" />
            <stroke android:width="1.2dp" android:color="#F0FFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#3EE2F2FF" android:endColor="#28C2E2FF" />
            <stroke android:width="1.2dp" android:color="#F0FFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#1CF6FBFF" android:endColor="#10DCEBF8" />
            <stroke android:width="0.95dp" android:color="#96F4FAFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
