<?xml version="1.0" encoding="utf-8"?>
<!-- Zyrox Sakura Blossom Capsule Filter Chip -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#52FFE4F2" android:endColor="#38F4A2CA" />
            <stroke android:width="1.2dp" android:color="#FAFFF7FB" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#4AFFE0F0" android:endColor="#30F298C3" />
            <stroke android:width="1.15dp" android:color="#F4FFF5FA" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#20FFF2F8" android:endColor="#12FAD4E8" />
            <stroke android:width="0.9dp" android:color="#6CFCE8F3" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
