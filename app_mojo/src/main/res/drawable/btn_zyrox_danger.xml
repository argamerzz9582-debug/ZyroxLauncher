<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#40171210" />
            <stroke
                android:width="1dp"
                android:color="#3378716C" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/zyrox_danger_pressed" />
            <stroke
                android:width="1.5dp"
                android:color="@color/zyrox_danger" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/zyrox_danger_tint" />
            <stroke
                android:width="1.5dp"
                android:color="@color/zyrox_danger" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
