<?xml version="1.0" encoding="utf-8"?>
<!-- Zyrox Ultra-Clear Rose-Ruby Liquid Glass Destructive Button -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#4CFCA5A5" android:endColor="#32F87171" />
            <stroke android:width="1.25dp" android:color="#F6FFF1F2" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#2EFCA5A5" android:centerColor="#16F87171" android:endColor="#24FDA4AF" />
                    <stroke android:width="1.1dp" android:color="#CCFFE4E6" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
            <item android:left="10dp" android:top="2.8dp" android:right="10dp" android:height="1.3dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#00FFFFFF" android:centerColor="#8AFFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
