<?xml version="1.0" encoding="utf-8"?>
<!-- Zyrox Starlight Twilight Elevated Liquid Glass Modal & Studio Surface -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#AD0F1628"
                android:centerColor="#9E0A101F"
                android:endColor="#AA0C1323" />
            <stroke android:width="1.2dp" android:color="#BCE9F2FE" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <!-- Soft upper starlight-ice dome glow -->
    <item android:left="1.5dp" android:top="1.5dp" android:right="1.5dp" android:height="24dp" android:gravity="top">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#22F0F7FF" android:endColor="#00FFFFFF" />
            <corners android:topLeftRadius="16.5dp" android:topRightRadius="16.5dp" />
        </shape>
    </item>
    <!-- Razor-thin top starlight-crystal specular crest -->
    <item android:left="22dp" android:top="2.4dp" android:right="22dp" android:height="1.3dp" android:gravity="top">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#00FFFFFF" android:centerColor="#8EF5F9FF" android:endColor="#00FFFFFF" />
            <corners android:radius="1dp" />
        </shape>
    </item>
</layer-list>
