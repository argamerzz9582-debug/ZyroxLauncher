<?xml version="1.0" encoding="utf-8"?>
<!-- Zyrox Sakura Twilight Elevated Liquid Glass Modal & Studio Surface -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#AD1C1128"
                android:centerColor="#9E150C1F"
                android:endColor="#AA180E23" />
            <stroke android:width="1.2dp" android:color="#BCFFE8F4" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <!-- Soft upper sakura-pearl dome glow -->
    <item android:left="1.5dp" android:top="1.5dp" android:right="1.5dp" android:height="24dp" android:gravity="top">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#22FFF0F8" android:endColor="#00FFFFFF" />
            <corners android:topLeftRadius="16.5dp" android:topRightRadius="16.5dp" />
        </shape>
    </item>
    <!-- Razor-thin top rose-pearl specular crest -->
    <item android:left="22dp" android:top="2.4dp" android:right="22dp" android:height="1.3dp" android:gravity="top">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#00FFFFFF" android:centerColor="#8EFFF5FA" android:endColor="#00FFFFFF" />
            <corners android:radius="1dp" />
        </shape>
    </item>
</layer-list>
